<UserControl x:Class="TRAMADE.FormulariosProveedor.ProveedoresPerfilControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#8a5c35"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"   Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding"      Value="20,16"/>
            <Setter Property="Margin"       Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                      Color="#c8b89a" Opacity="0.15" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Poppins"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="#8a5c35"/>
            <Setter Property="Margin"      Value="0,0,0,10"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Poppins"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="Foreground"  Value="#9a7a5a"/>
            <Setter Property="Margin"      Value="0,0,0,2"/>
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Poppins"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="#3d2b1f"/>
            <Setter Property="Margin"      Value="0,0,0,10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="BtnEditar" TargetType="Button">
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Background"      Value="#8a5c35"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="24,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#7a4e2c"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Contenido -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="28,20,28,16">
            <TextBlock Text="Perfil del Proveedor"
                       FontFamily="Poppins" FontSize="22" FontWeight="Bold"
                       Foreground="White"/>
        </StackPanel>

        <!-- CONTENIDO -->
        <Border Grid.Row="1" Background="White" CornerRadius="14,14,14,14"
                Margin="12,0,12,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                  Color="#c8b89a" Opacity="0.15" Direction="270"/>
            </Border.Effect>
            <StackPanel Margin="24,20">
                <StackPanel>

                    <!-- INFORMACIÓN GENERAL -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Información general" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ID Proveedor" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="txtIdProveedor" Style="{StaticResource FieldValue}"/>
                                    <TextBlock Text="Nombre Comercial" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="txtNombreComercial" Style="{StaticResource FieldValue}"/>
                                    <TextBlock Text="Razón Social" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="txtRazonSocial" Style="{StaticResource FieldValue}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Dirección" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="txtDireccion" Style="{StaticResource FieldValue}"/>
                                    <TextBlock Text="RTN" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="txtRtn" Style="{StaticResource FieldValue}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- DATOS DE CONTACTO -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Datos de contacto" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Contacto" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="txtContacto" Style="{StaticResource FieldValue}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Correo Electrónico" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="txtCorreo" Style="{StaticResource FieldValue}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CLASIFICACIÓN -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Clasificación" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Clasificación" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="txtClasificacion" Style="{StaticResource FieldValue}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Términos de Pago" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="txtTerminosPago" Style="{StaticResource FieldValue}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Días de Crédito" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="txtDiasCredito" Style="{StaticResource FieldValue}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- BOTÓN EDITAR -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button x:Name="btnCancelar" Style="{StaticResource BtnEditar}"
        Background="#f0ebe5" Foreground="#3d2b1f"
        Margin="0,0,10,0"
        Click="btnCancelar_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✕  " VerticalAlignment="Center"/>
                                <TextBlock Text="CERRAR" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnEditar" Style="{StaticResource BtnEditar}"
                            Click="btnEditar_Click">
                            <TextBlock Text="✎  EDITAR"/>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
