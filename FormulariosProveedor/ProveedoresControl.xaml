<UserControl x:Class="TRAMADE.FormulariosProveedor.ProveedoresControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#f5f0eb"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ProveedoresStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Título + subtítulo -->
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <!-- Instrucciones -->
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <StackPanel Grid.Row="0" Margin="2,0,0,10">
            <TextBlock Text="PROVEEDORES" FontFamily="Poppins" FontSize="10"
                       Foreground="#9a7a5a" FontWeight="Medium"/>
            <TextBlock Text="Listado de Proveedores" FontFamily="Poppins" FontSize="12"
                       Foreground="#9a7a5a" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- TOOLBAR -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Btn Añadir -->
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <!-- Búsqueda: toma todo el espacio sobrante -->
                    <ColumnDefinition Width="16"/>
                    <!-- Spacer fijo pequeño (antes era "*") -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Btn Activar -->
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Btn Inactivar -->
                </Grid.ColumnDefinitions>

                <!-- Botón Añadir -->
                <Button Grid.Column="0" x:Name="btnAñadirProveedor"
                        Style="{StaticResource BtnPrimary}"
                        Height="34" Click="btnAñadirProveedor_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Añadir Proveedor" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Búsqueda -->
                <TextBox Grid.Column="2" x:Name="txtBuscar"
                 Style="{StaticResource SearchBox}"
                 Height="34"
                 MinWidth="150"
                 TextChanged="txtBuscar_TextChanged"/>   

                <!-- Botón Activar -->
                <Button Grid.Column="4" x:Name="btnActivarSeleccion"
                        Style="{StaticResource BtnActivar}"
                        Height="34" Click="btnActivarSeleccion_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Activar Selección" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Botón Inactivar -->
                <Button Grid.Column="6" x:Name="btnInactivarSeleccion"
                        Style="{StaticResource BtnInactivar}"
                        Height="34" Click="btnInactivarSeleccion_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⊘" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Inactivar Selección" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- DATAGRID -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0">
            <DataGrid x:Name="dgvProveedor"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserResizeColumns="False"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#f0e8de"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#fdf9f5"
                      BorderThickness="0"
                      RowHeaderWidth="0"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      ColumnHeaderStyle="{StaticResource DgHeaderStyle}"
                      CellStyle="{StaticResource DgCellStyle}"
                      RowStyle="{StaticResource DgRowStyle}"
                      RowHeight="34"
                      ColumnHeaderHeight="36"
                      MouseDoubleClick="dgvProveedor_MouseDoubleClick">

                <DataGrid.Columns>
                    <!-- Checkbox -->
                    <DataGridTemplateColumn Header="Sel." Width="50" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Seleccionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Razón Social"     Binding="{Binding RazonSocial}"      Width="2*"   IsReadOnly="True"/>
                    <DataGridTextColumn Header="Nombre Comercial" Binding="{Binding NombreComercial}"  Width="2*"   IsReadOnly="True"/>
                    <DataGridTextColumn Header="RTN"              Binding="{Binding RTN}"              Width="1.4*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Teléfono"         Binding="{Binding TelefonoPrincipal}" Width="1*"  IsReadOnly="True"/>
                    <DataGridTextColumn Header="Estado"           Binding="{Binding Estado}"           Width="0.8*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Clasificación"    Binding="{Binding Clasificacion}"    Width="1*"   IsReadOnly="True"/>
                    <DataGridTextColumn Header="Términos Pago"    Binding="{Binding TerminosPago}"     Width="1.5*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- INSTRUCCIONES -->
        <StackPanel Grid.Row="5" HorizontalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" Foreground="#9a7a5a"
                       FontFamily="Poppins" FontSize="11">
                <Run Text="🔍  Doble clic en una fila para ver el perfil del proveedor"/>
            </TextBlock>
            <TextBlock HorizontalAlignment="Center" Foreground="#9a7a5a"
                       FontFamily="Poppins" FontSize="11" Margin="0,2,0,0">
                <Run Text="🔍  Seleccione la casilla del proveedor(s) que desea cambiar estado"/>
            </TextBlock>
        </StackPanel>

    </Grid>
</UserControl>
