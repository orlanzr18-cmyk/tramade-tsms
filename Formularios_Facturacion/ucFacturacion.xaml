<UserControl x:Class="TRAMADE.ucFacturacionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#f5f0eb"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>

        <!-- ══ Card ══════════════════════════════════════════════════════ -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"   Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding"      Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                      Color="#c8b89a" Opacity="0.15" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ TextBox redondeado con placeholder nativo ══════════════════ -->
        <Style x:Key="TxtStyle" TargetType="TextBox">
            <Setter Property="FontFamily"               Value="Poppins"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Foreground"               Value="#3d2b1f"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="BorderBrush"              Value="#e0d0c0"/>
            <Setter Property="BorderThickness"          Value="1.5"/>
            <Setter Property="Height"                   Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding"                  Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Poppins" FontSize="12"
                                           Foreground="#b89870"
                                           Margin="11,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text"      Value=""/>
                                    <Condition Property="IsFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ DatePicker redondeado ══════════════════════════════════════ -->
        <Style x:Key="BrownDatePickerTextBox" TargetType="DatePickerTextBox">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Foreground"               Value="#3d2b1f"/>
            <Setter Property="FontFamily"               Value="Poppins"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding"                  Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Border Background="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BrownDatePicker" TargetType="DatePicker">
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#3d2b1f"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#e0d0c0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Style="{StaticResource BrownDatePickerTextBox}"
                                                   Margin="11,0,0,0"
                                                   VerticalAlignment="Center"/>
                                <Button x:Name="PART_Button" Grid.Column="1"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <TextBlock Text="📅" FontSize="13"
                                                           Foreground="#8a5c35"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Popup x:Name="PART_Popup" Grid.ColumnSpan="2"
                                       Placement="Bottom" StaysOpen="False"
                                       AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border Background="White" BorderBrush="#e0d0c0"
                                            BorderThickness="1.5" CornerRadius="8" Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                                              Color="#c8b89a" Opacity="0.2" Direction="270"/>
                                        </Border.Effect>
                                        <Calendar x:Name="Calendar"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Botones ════════════════════════════════════════════════════ -->
        <Style x:Key="BtnPrimario" TargetType="Button">
            <Setter Property="Background"      Value="#8a5c35"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#7a4e2c"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#6a4025"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnVerde" TargetType="Button">
            <Setter Property="Background"      Value="#2e7d52"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#235e3d"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1a4a30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnAzul" TargetType="Button">
            <Setter Property="Background"      Value="#2563a8"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1a4d8a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#133a6a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnRojo" TargetType="Button">
            <Setter Property="Background"      Value="#c0392b"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#a93226"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#922b21"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnNeutro" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#8a5c35"/>
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush"     Value="#daa564"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#fef4e6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#fde8c8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Sugerencias popup ══════════════════════════════════════════ -->
        <Style x:Key="SugerenciaItemStyle" TargetType="ListBoxItem">
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#3d2b1f"/>
            <Setter Property="Padding"    Value="10,6"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#fef4e6"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#fde8c8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ══ DataGrid ══════════════════════════════════════════════════ -->
        <Style x:Key="DgHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"          Value="#8a5c35"/>
            <Setter Property="Foreground"          Value="White"/>
            <Setter Property="FontFamily"          Value="Poppins"/>
            <Setter Property="FontWeight"          Value="SemiBold"/>
            <Setter Property="FontSize"            Value="11"/>
            <Setter Property="Padding"             Value="12,8"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="SeparatorBrush"      Value="#a07040"/>
            <Setter Property="SeparatorVisibility" Value="Visible"/>
        </Style>

        <Style x:Key="DgCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Foreground"      Value="#3d2b1f"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#fde8c8"/>
                    <Setter Property="Foreground" Value="#3d2b1f"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LblCampo" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Foreground" Value="#9a7a5a"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16,12,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══ FILA 0 — Título + botón historial ════════════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Facturación"
                               FontFamily="Poppins" FontSize="22" FontWeight="SemiBold"
                               Foreground="#3d2b1f"/>
                    <TextBlock Text="NUEVA FACTURA"
                               FontFamily="Poppins" FontSize="10"
                               Foreground="#9a7a5a" FontWeight="Medium"/>
                </StackPanel>
                <Button x:Name="btnVerFacturas" HorizontalAlignment="Right"
                        Style="{StaticResource BtnPrimario}"
                        Content="📋  Ver facturas emitidas"
                        Click="btnVerFacturas_Click"/>
            </Grid>

            <!-- ══ FILA 1 — Número + aviso + fechas ══════════════════════════ -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Número de factura:" Style="{StaticResource LblCampo}"/>
                        <TextBlock x:Name="txtNumeroFactura" Text="INV/2026/0001"
                                   FontFamily="Poppins" FontSize="22" FontWeight="Bold"
                                   Foreground="#3d2b1f"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Text="Los espacios con ( ! ) deben contener información de manera obligatoria"
                               FontFamily="Poppins" FontSize="10" Foreground="#9a7a5a"
                               TextWrapping="Wrap" Margin="0,0,24,0"/>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="( ! ) Fecha de emisión:" Style="{StaticResource LblCampo}"
                                   Foreground="#c0392b"/>
                        <DatePicker x:Name="dtpEmision"
                                    Style="{StaticResource BrownDatePicker}"
                                    Width="150"
                                    SelectedDateChanged="dtpEmision_SelectedDateChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="( ! ) Fecha de vencimiento:" Style="{StaticResource LblCampo}"
                                   Foreground="#c0392b"/>
                        <DatePicker x:Name="dtpVencimiento"
                                    Style="{StaticResource BrownDatePicker}"
                                    Width="150"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ FILA 2 — Datos cliente + vendedor ════════════════════════ -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="0.6*"/>
                </Grid.ColumnDefinitions>

                <!-- Datos del cliente -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Datos del cliente"
                                   FontFamily="Poppins" FontSize="13" FontWeight="Medium"
                                   Foreground="#3d2b1f" Margin="0,0,0,12"/>

                        <!-- DNI / RTN -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DNI/RTN:"
                                       Style="{StaticResource LblCampo}"
                                       VerticalAlignment="Center"/>
                            <Grid Grid.Column="1">
                                <TextBox x:Name="txtDNICliente"
             Style="{StaticResource TxtStyle}"
             Tag="Buscar por DNI o RTN"
             Padding="10,0,30,0"
             GotFocus="PlaceholderGotFocus"
             LostFocus="PlaceholderLostFocus"
             TextChanged="txtDNICliente_TextChanged"/>
                                <TextBlock Text="🔍"
               FontSize="12"
               Foreground="#b89870"
               HorizontalAlignment="Right"
               VerticalAlignment="Center"
               Margin="0,0,10,0"
               IsHitTestVisible="False"/>
                                <Popup x:Name="popupSugerencias"
           PlacementTarget="{Binding ElementName=txtDNICliente}"
           Placement="Bottom" StaysOpen="False"
           AllowsTransparency="True">
                                    <Border Background="White" BorderBrush="#e0d0c0"
                BorderThickness="1.5" CornerRadius="8">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                  Color="#c8b89a" Opacity="0.2" Direction="270"/>
                                        </Border.Effect>
                                        <ListBox x:Name="lstSugerencias"
         MaxHeight="160" MinWidth="250"
         FontFamily="Poppins" FontSize="11"
         BorderThickness="0" Background="White"
         ItemContainerStyle="{StaticResource SugerenciaItemStyle}"
         PreviewMouseLeftButtonDown="lstSugerencias_PreviewMouseLeftButtonDown"
         SelectionChanged="lstSugerencias_SelectionChanged"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>

                        <!-- Nombre -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="( ! ) Cliente:"
                                       Style="{StaticResource LblCampo}"
                                       Foreground="#c0392b" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="txtNombreCliente"
                                     Style="{StaticResource TxtStyle}"
                                     Tag="( ! ) Nombre del cliente"
                                     GotFocus="PlaceholderGotFocus"
                                     LostFocus="PlaceholderLostFocus"/>
                        </Grid>

                        <!-- Dirección -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="( ! ) Dirección:"
                                       Style="{StaticResource LblCampo}"
                                       Foreground="#c0392b" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="txtDireccionCliente"
                                     Style="{StaticResource TxtStyle}"
                                     Tag="( ! ) Dirección del cliente"
                                     GotFocus="PlaceholderGotFocus"
                                     LostFocus="PlaceholderLostFocus"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Datos del vendedor -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Datos del vendedor"
                                   FontFamily="Poppins" FontSize="13" FontWeight="Medium"
                                   Foreground="#3d2b1f" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ID:"
                                       Style="{StaticResource LblCampo}"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="txtIDVendedor"
                                     Style="{StaticResource TxtStyle}" IsReadOnly="True"
                                     Tag=""/>
                            <Button Grid.Column="2" Content="🔄" Margin="6,0,0,0"
                                    Style="{StaticResource BtnNeutro}" Padding="10,5"
                                    Click="btnIDVendedor_Click"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Nombre:"
                                       Style="{StaticResource LblCampo}"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="txtNombreVendedor"
                                     Style="{StaticResource TxtStyle}" IsReadOnly="True"
                                     Tag=""/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══ FILA 3 — DataGrid productos ══════════════════════════════ -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,0">
                <DataGrid x:Name="dgvDetalleFactura"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#f0e8de"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#fdf9f5"
                          BorderThickness="0"
                          RowHeaderWidth="0"
                          SelectionMode="Single"
                          MinHeight="140" MaxHeight="220"
                          ColumnHeaderStyle="{StaticResource DgHeaderStyle}"
                          CellStyle="{StaticResource DgCellStyle}"
                          CellEditEnding="dgvDetalleFactura_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"              Binding="{Binding Col0}" Visibility="Collapsed"/>
                        <DataGridTextColumn Header="Producto"        Binding="{Binding Col1}" Width="2.5*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Descripción"     Binding="{Binding Col2}" Width="1.5*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Cantidad"        Binding="{Binding Col3}" Width="*"/>
                        <DataGridTextColumn Header="Precio unitario" Binding="{Binding Col4}" Width="*"    IsReadOnly="True"/>
                        <DataGridTextColumn Header="Subtotal"        Binding="{Binding Col5}" Width="*"    IsReadOnly="True"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#fef4e6"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#fdf5ea"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Border>

            <!-- ══ FILA 4 — Botones agregar / eliminar ══════════════════════ -->
            <Grid Grid.Row="4" Margin="0,10,0,10">
                <Button x:Name="btnAggProducto" HorizontalAlignment="Left"
                        Style="{StaticResource BtnVerde}"
                        Content="➕  Agregar producto"
                        Click="btnAggProducto_Click"/>
                <Button x:Name="btnEliminarProducto" HorizontalAlignment="Right"
                        Style="{StaticResource BtnRojo}"
                        Content="✕  Eliminar producto"
                        Click="btnEliminarProducto_Click"/>
            </Grid>

            <!-- ══ FILA 5 — Forma de pago + Totales ══════════════════════════ -->
            <Grid Grid.Row="5" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <!-- Forma de pago -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="( ! ) Seleccione la forma de pago:"
                                   FontFamily="Poppins" FontSize="11" Foreground="#c0392b"
                                   Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="rbContado" Content="Contado"
                                         FontFamily="Poppins" FontSize="12" Foreground="#3d2b1f"
                                         Margin="0,0,24,0" GroupName="FormaPago"
                                         Checked="rbFormaPago_Checked"/>
                            <RadioButton x:Name="rbCredito" Content="Crédito"
                                         FontFamily="Poppins" FontSize="12" Foreground="#3d2b1f"
                                         GroupName="FormaPago"
                                         Checked="rbFormaPago_Checked"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Totales -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="Subtotal:" FontFamily="Poppins" FontSize="12"
                                       Foreground="#5a3e2b" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="lblSubtotal" Text="L. 0.00"
                                       FontFamily="Poppins" FontSize="12" Foreground="#3d7a55"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <TextBlock Text="Impuesto 15%:" FontFamily="Poppins" FontSize="12"
                                       Foreground="#5a3e2b" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="lblImpuesto" Text="L. 0.00"
                                       FontFamily="Poppins" FontSize="12" Foreground="#3d7a55"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Grid.Row="2" Background="#f0e8de" Height="1" Margin="0,4,0,4"/>
                        <Grid Grid.Row="3">
                            <TextBlock Text="Total a pagar:" FontFamily="Poppins" FontSize="14"
                                       FontWeight="Bold" Foreground="#3d2b1f" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="lblTotal" Text="L. 0.00"
                                       FontFamily="Poppins" FontSize="14" FontWeight="Bold"
                                       Foreground="#2d1f14" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══ FILA 6 — Acciones finales ═════════════════════════════════ -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,4,0,8">
                <Button x:Name="btnNuevo"        Content="🗒  Nuevo"
                        Style="{StaticResource BtnNeutro}" Margin="0,0,8,0"
                        Click="btnNuevo_Click"/>
                <Button x:Name="btnLimpiar"      Content="🧹  Limpiar"
                        Style="{StaticResource BtnNeutro}" Margin="0,0,8,0"
                        Click="btnLimpiar_Click"/>
                <Button x:Name="btnVistaPrevia"  Content="👁  Vista previa"
                        Style="{StaticResource BtnAzul}" Margin="0,0,8,0"
                        Click="btnVistaPrevia_Click"/>
                <Button x:Name="btnEmitirFactura" Content="✅  Emitir factura"
                        Style="{StaticResource BtnVerde}"
                        Click="btnEmitirFactura_Click"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>
