<UserControl x:Class="TRAMADE.wndHistorialFacturas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>

        <!-- ── Panel exterior blanco (idéntico al CardStyle de RegistrarCompraControl) ── -->
        <Style x:Key="PageCardStyle" TargetType="Border">
            <Setter Property="Background"   Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding"      Value="28,24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4"
                                      Color="#3d2b1f" Opacity="0.18" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"   Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding"      Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                      Color="#c8b89a" Opacity="0.15" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPrimario" TargetType="Button">
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Background"      Value="#8a5c35"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#7a4e2c"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#6a4025"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#c8b8a8"/>
                                <Setter TargetName="Root" Property="Opacity"     Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnAzul" TargetType="Button">
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Background"      Value="#2563a8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1a4d8a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#123a68"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#c8b8a8"/>
                                <Setter TargetName="Root" Property="Opacity"     Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnNeutro" TargetType="Button">
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Foreground"      Value="#8a5c35"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                BorderBrush="#daa564" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#fef4e6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#fde8c8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnRojo" TargetType="Button">
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Background"      Value="#c0392b"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#a93226"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#922b21"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#c8b8a8"/>
                                <Setter TargetName="Root" Property="Opacity"     Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TxtStyle" TargetType="TextBox">
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#3d2b1f"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#e0d0c0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             DATEPICKER — tomado tal cual de ucReportes (BrownDatePicker
             + BrownDatePickerTextBox): borde café, ícono de calendario
             propio, popup con Calendar estilizado.
        ═══════════════════════════════════════════════════════════ -->
        <Style x:Key="BrownDatePickerTextBox" TargetType="DatePickerTextBox">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#3d2b1f"/>
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Border Background="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BrownDatePicker" TargetType="DatePicker">
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#3d2b1f"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"      Value="#e0d0c0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height"          Value="38"/>
            <Setter Property="CalendarStyle">
                <Setter.Value>
                    <Style TargetType="Calendar">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="#e0d0c0"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="FontFamily" Value="Poppins"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>

                                <DatePickerTextBox x:Name="PART_TextBox"
                                                    Grid.Column="0"
                                                    Style="{StaticResource BrownDatePickerTextBox}"
                                                    Margin="11,0,0,0"
                                                    VerticalAlignment="Center"/>

                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <TextBlock Text="📅"
                                                           FontSize="13"
                                                           Foreground="#8a5c35"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Popup x:Name="PART_Popup"
                                       Grid.ColumnSpan="2"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Slide">
                                    <Border Background="White"
                                            BorderBrush="#e0d0c0"
                                            BorderThickness="1.5"
                                            CornerRadius="8"
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                                              Color="#c8b89a" Opacity="0.2" Direction="270"/>
                                        </Border.Effect>
                                        <Calendar x:Name="Calendar"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DgHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"          Value="#8a5c35"/>
            <Setter Property="Foreground"          Value="White"/>
            <Setter Property="FontFamily"          Value="Poppins"/>
            <Setter Property="FontWeight"          Value="SemiBold"/>
            <Setter Property="FontSize"            Value="11"/>
            <Setter Property="Padding"             Value="12,8"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="SeparatorBrush"      Value="#a07040"/>
            <Setter Property="SeparatorVisibility" Value="Visible"/>
        </Style>

        <Style x:Key="DgCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Foreground"      Value="#3d2b1f"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#fde8c8"/>
                    <Setter Property="Foreground" Value="#3d2b1f"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <!-- ── Fondo café (idéntico a RegistrarCompraControl) + panel blanco único ── -->
    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="#8a5c35"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="74"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título blanco, mismo estilo que "REGISTRO DE SOLICITUD DE COMPRAS" -->
        <TextBlock Text="HISTORIAL DE FACTURAS"
                   FontFamily="Poppins" FontSize="18"
                   FontWeight="SemiBold" Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,18,0,0"
                   Opacity="0.9"/>

        <!-- Panel blanco único que contiene TODOS los componentes -->
        <Border Grid.Row="1"
                Style="{StaticResource PageCardStyle}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="32,0,32,18">

            <Grid Margin="16,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Título -->
                    <RowDefinition Height="Auto"/>
                    <!-- Buscador + filtros -->
                    <RowDefinition Height="*"/>
                    <!-- Tabla -->
                    <RowDefinition Height="Auto"/>
                    <!-- Botones -->
                </Grid.RowDefinitions>

                <!-- ══════════════════════════════════════════
                     FILA 0 — Título
                ══════════════════════════════════════════ -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Historial de Facturas"
                                   FontFamily="Poppins" FontSize="20" FontWeight="SemiBold"
                                   Foreground="#3d2b1f"/>
                        <TextBlock Text="FACTURAS EMITIDAS"
                                   FontFamily="Poppins" FontSize="10"
                                   Foreground="#9a7a5a" FontWeight="Medium"/>
                    </StackPanel>
                </Grid>

                <!-- ══════════════════════════════════════════
                     FILA 1 — Buscador + filtro fecha + ordenar
                ══════════════════════════════════════════ -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Buscador -->
                        <TextBox x:Name="txtBuscarFactura"
                                 Grid.Column="0"
                                 Style="{StaticResource TxtStyle}"
                                 Text="Número de factura, ID de vendedor o DNI/RTN"
                                 Foreground="#b0a090"
                                 GotFocus="txtBuscar_GotFocus"
                                 LostFocus="txtBuscar_LostFocus"
                                 Tag="Número de factura, ID de vendedor o DNI/RTN"
                                 TextChanged="txtBuscarFactura_TextChanged"/>

                        <!-- Botón calendario -->
                        <Button x:Name="btnCalendarioFacturas"
                                Grid.Column="1"
                                Content="📅"
                                Style="{StaticResource BtnPrimario}"
                                Padding="10,0" Margin="8,0,0,0"
                                ToolTip="Filtrar por fecha"
                                Click="btnCalendarioFacturas_Click"/>

                        <!-- DatePicker: solo selección desde calendario, sin escritura manual -->
                        <DatePicker x:Name="dtpCalendario"
                                    Grid.Column="2"
                                    Style="{StaticResource BrownDatePicker}"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"/>

                        <!-- Botón ordenar -->
                        <Button x:Name="btnOrdenarFacturas"
                                Grid.Column="3"
                                Content="⇅  Ordenar"
                                Style="{StaticResource BtnNeutro}"
                                Margin="8,0,0,0"
                                ToolTip="Alternar orden ascendente/descendente"
                                Click="btnOrdenarFacturas_Click"/>

                        <!-- Botón limpiar filtro fecha -->
                        <Button x:Name="btnLimpiarFecha"
                                Grid.Column="4"
                                Content="🧹"
                                Style="{StaticResource BtnNeutro}"
                                Padding="10,0" Margin="6,0,0,0"
                                ToolTip="Limpiar filtro de fecha"
                                Click="btnLimpiarFecha_Click"/>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════
                     FILA 2 — Tabla de facturas
                ══════════════════════════════════════════ -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}"
                        Padding="16,14" Margin="0,0,0,10">
                    <DataGrid x:Name="dgvHistorialFacturas"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserSortColumns="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#f0e8de"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#fdf9f5"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              ColumnHeaderStyle="{StaticResource DgHeaderStyle}"
                              CellStyle="{StaticResource DgCellStyle}"
                              MouseDoubleClick="dgvHistorialFacturas_MouseDoubleClick">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"
                                                Binding="{Binding Numeral}"
                                                Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Número de factura"
                                                Binding="{Binding NumFactura}"
                                                Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="ID Vendedor"
                                                Binding="{Binding IDVendedor}"
                                                Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="DNI/RTN Cliente"
                                                Binding="{Binding DNIRTNCliente}"
                                                Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Fecha de emisión"
                                                Binding="{Binding FechaEmision}"
                                                Width="130" IsReadOnly="True"/>
                        </DataGrid.Columns>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#fef4e6"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#fdf5ea"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Border>

                <!-- ══════════════════════════════════════════
                     FILA 3 — Botones
                ══════════════════════════════════════════ -->
                <Grid Grid.Row="3">
                    <Button x:Name="btnVerFacturaHF"
                            HorizontalAlignment="Left"
                            Content="👁  Ver factura"
                            Style="{StaticResource BtnAzul}"
                            Click="btnVerFacturaHF_Click"/>
                    <Button x:Name="btnRegresarHF"
                            HorizontalAlignment="Right"
                            Content="✖  Cerrar"
                            Style="{StaticResource BtnRojo}"
                            Click="btnRegresarHF_Click"/>
                </Grid>

            </Grid>

        </Border>
    </Grid>
</UserControl>