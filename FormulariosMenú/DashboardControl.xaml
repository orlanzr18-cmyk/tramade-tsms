<UserControl x:Class="TRAMADE.DashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             Background="#f5f0eb">

    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"   Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding"      Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                      Color="#c8b89a" Opacity="0.15" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCardButton" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment"   Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="14" Padding="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                                  Color="#c8b89a" Opacity="0.15" Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#fef4e6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#fde8c8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo header del DataGrid -->
        <Style x:Key="DgHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"       Value="#8a5c35"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="FontFamily"       Value="Poppins"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="Padding"          Value="12,8"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="SeparatorBrush"   Value="#a07040"/>
            <Setter Property="SeparatorVisibility" Value="Visible"/>
        </Style>

        <!-- Estilo celda del DataGrid -->
        <Style x:Key="DgCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Foreground"      Value="#3d2b1f"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#fde8c8"/>
                    <Setter Property="Foreground" Value="#3d2b1f"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Fecha -->
            <RowDefinition Height="Auto"/>
            <!-- Stat cards -->
            <RowDefinition Height="0.45*" MinHeight="160"/>
            <!-- Clientes + Gráficas -->
            <RowDefinition Height="10"/>
            <!-- Separador -->
            <RowDefinition Height="0.55*" MinHeight="180"/>
            <!-- DataGrid compras -->
        </Grid.RowDefinitions>

        <!-- Fecha -->
        <StackPanel Grid.Row="0" Margin="2,0,0,10">
            <TextBlock x:Name="txtFecha" FontFamily="Poppins" FontSize="12"
                       Foreground="#9a7a5a" Margin="0,0,0,4"/>
            <TextBlock Text="RESUMEN" FontFamily="Poppins" FontSize="10"
                       Foreground="#9a7a5a" FontWeight="Medium"/>
        </StackPanel>

        <!-- 4 stat cards -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="btnProductos"
                    Style="{StaticResource StatCardButton}" MinHeight="130" Click="btnProductos_Click">
                <StackPanel>
                    <TextBlock Text="📦" FontSize="20" Margin="0,0,0,6"/>
                    <TextBlock Text="Total Productos" FontFamily="Poppins"
                               FontSize="11" Foreground="#9a7a5a" Margin="0,0,0,4"/>
                    <TextBlock x:Name="txtTotalProductos" Text="—"
                               FontFamily="Poppins" FontSize="30"
                               FontWeight="SemiBold" Foreground="#2d1f14"/>
                    <TextBlock x:Name="txtSubProductos" FontFamily="Poppins"
                               FontSize="10" Foreground="#b89870" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2" x:Name="btnAgotados"
                    Style="{StaticResource StatCardButton}" MinHeight="130" Click="btnAgotados_Click">
                <StackPanel>
                    <TextBlock Text="⚠" FontSize="20" Margin="0,0,0,6"/>
                    <TextBlock Text="Productos Agotados" FontFamily="Poppins"
                               FontSize="11" Foreground="#9a7a5a" Margin="0,0,0,4"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="txtTotalAgotados" Text="—"
                               FontFamily="Poppins" FontSize="30"
                               FontWeight="SemiBold" Foreground="#2d1f14"/>
                    <TextBlock Text="Requieren atención" FontFamily="Poppins"
                               FontSize="10" Foreground="#c0392b" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="4" x:Name="btnIngresos"
                    Style="{StaticResource StatCardButton}" MinHeight="130" Click="btnIngresos_Click">
                <StackPanel>
                    <TextBlock Text="💰" FontSize="20" Margin="0,0,0,6"/>
                    <TextBlock Text="Ingresos del Mes" FontFamily="Poppins"
                               FontSize="11" Foreground="#9a7a5a" Margin="0,0,0,4"/>
                    <TextBlock x:Name="txtIngresosMes" Text="—"
                               FontFamily="Poppins" FontSize="20"
                               FontWeight="SemiBold" Foreground="#2e7d52"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Facturado este mes" FontFamily="Poppins"
                               FontSize="10" Foreground="#b89870" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="6" x:Name="btnDeudores"
                    Style="{StaticResource StatCardButton}" MinHeight="130" Click="btnDeudores_Click">
                <StackPanel>
                    <TextBlock Text="📋" FontSize="20" Margin="0,0,0,6"/>
                    <TextBlock Text="Deudores Pendientes" FontFamily="Poppins"
                               FontSize="11" Foreground="#9a7a5a" Margin="0,0,0,4"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="txtDeudoresPendientes" Text="—"
                               FontFamily="Poppins" FontSize="30"
                               FontWeight="SemiBold" Foreground="#2d1f14"/>
                    <TextBlock Text="Con saldo pendiente" FontFamily="Poppins"
                               FontSize="10" Foreground="#b89870" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Clientes + Gráficas compactas -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.22*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="0.39*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="0.39*"/>
            </Grid.ColumnDefinitions>

            <!-- Clientes — simple -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Clientes" FontFamily="Poppins" FontSize="14"
                               Foreground="#3d2b1f" FontWeight="Medium" Margin="0,0,0,6"/>
                    <TextBlock Text="👥" FontSize="28" Opacity="0.75" Margin="0,0,0,4"/>
                    <TextBlock x:Name="txtTotalClientes" Text="—"
                               FontFamily="Poppins" FontSize="34"
                               FontWeight="SemiBold" Foreground="#8a5c35"/>
                    <TextBlock Text="Total Clientes Registrados" FontFamily="Poppins"
                               FontSize="11" Foreground="#9a7a5a" Margin="0,3,0,10"
                               TextWrapping="Wrap"/>
                    <Border Background="#f0e8de" CornerRadius="4" Height="7">
                        <Border x:Name="barraActivos" Background="#daa564"
                                CornerRadius="4" HorizontalAlignment="Left" Width="0"/>
                    </Border>
                    <Grid Margin="0,6,0,0">
                        <TextBlock x:Name="txtPorcentajeActivos" FontFamily="Poppins"
                                   FontSize="11" Foreground="#9a7a5a" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="txtRatioClientes" FontFamily="Poppins"
                                   FontSize="11" Foreground="#9a7a5a" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Inventario compacto -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Gestión de Inventario"
                               FontFamily="Poppins" FontSize="13"
                               Foreground="#3d2b1f" FontWeight="Medium" Margin="0,0,0,6"/>
                    <oxy:PlotView Grid.Row="1" x:Name="plotInventario" Background="White"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
            HorizontalAlignment="Center" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                            <Ellipse Width="9" Height="9" Fill="#27ae60"
                 VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Normal" FontFamily="Poppins" FontSize="10"
                   Foreground="#5a3e2b" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                            <Ellipse Width="9" Height="9" Fill="#e67e22"
                 VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Bajo" FontFamily="Poppins" FontSize="10"
                   Foreground="#5a3e2b" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                            <Ellipse Width="9" Height="9" Fill="#e74c3c"
                 VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Crítico" FontFamily="Poppins" FontSize="10"
                   Foreground="#5a3e2b" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="#c0392b"
                 VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Agotado" FontFamily="Poppins" FontSize="10"
                   Foreground="#5a3e2b" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tendencia compacta -->
            <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Tendencia de Ventas"
                               FontFamily="Poppins" FontSize="13"
                               Foreground="#3d2b1f" FontWeight="Medium"/>
                    <TextBlock Grid.Row="1" Text="Últimos 6 meses" FontFamily="Poppins"
                               FontSize="10" Foreground="#9a7a5a" Margin="0,2,0,6"/>
                    <oxy:PlotView Grid.Row="2" x:Name="plotTendencia" Background="White"/>
                </Grid>
            </Border>
        </Grid>

        <!-- DataGrid Compras Recientes — ancho completo -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header del DataGrid -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Compras Recientes"
                               FontFamily="Poppins" FontSize="15"
                               Foreground="#3d2b1f" FontWeight="Medium"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Últimas 8 compras registradas"
                               FontFamily="Poppins" FontSize="10"
                               Foreground="#9a7a5a"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1"
                          x:Name="dgComprasRecientes"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="False"
                          CanUserSortColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#f0e8de"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#fdf9f5"
                          BorderThickness="0"
                          RowHeaderWidth="0"
                          SelectionMode="Single"
                          ColumnHeaderStyle="{StaticResource DgHeaderStyle}"
                          CellStyle="{StaticResource DgCellStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="2*"/>
                        <DataGridTextColumn Header="Monto"     Binding="{Binding Monto}"     Width="*"/>
                        <DataGridTextColumn Header="Fecha"     Binding="{Binding Fecha}"     Width="*"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#fef4e6"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#fdf5ea"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
