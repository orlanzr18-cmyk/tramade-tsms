<Window x:Class="TRAMADE.RecuperarContrasenaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recuperar contraseña" Height="430" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F0EDE9">

    <Window.Resources>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#D8D3C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="LblTitulo" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="#3A2E22"/>
        </Style>
        <Style x:Key="BtnConfirmar" TargetType="Button">
            <Setter Property="Background" Value="#8B5E3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="BtnCancelar" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#8B5E3C"/>
            <Setter Property="BorderBrush" Value="#D8B98C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="InputPassword" TargetType="PasswordBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#D8D3C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="CajaCodigo" TargetType="TextBox">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MaxLength" Value="1"/>
            <Setter Property="BorderBrush" Value="#D8D3C8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#8B5E3C">
            <TextBlock Text="RECUPERAR CONTRASEÑA" Foreground="White" FontWeight="Bold"
                       FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Card -->
        <Border Grid.Row="1" Background="White" CornerRadius="0,0,8,8" Margin="0,0,0,0" Padding="30,25">
            <Grid>

                <!-- PASO 1: correo -->
                <StackPanel x:Name="PanelCorreo" Visibility="Visible">
                    <TextBlock Text="Ingresa tu correo electrónico" Style="{StaticResource LblTitulo}"/>
                    <TextBlock Text="Te enviaremos un código de verificación de 6 dígitos."
                               Foreground="#7A7268" FontSize="12" Margin="0,0,0,18" TextWrapping="Wrap"/>
                    <TextBox x:Name="txtCorreo" Style="{StaticResource InputBox}"/>
                    <TextBlock x:Name="lblErrorCorreo" Foreground="#C0392B" FontSize="11"
                               Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                    <Grid Margin="0,30,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar" Style="{StaticResource BtnCancelar}" Click="BtnCancelar_Click"/>
                        <Button Grid.Column="2" Content="Enviar código" Style="{StaticResource BtnConfirmar}" Click="BtnEnviarCodigo_Click"/>
                    </Grid>
                </StackPanel>

                <!-- PASO 2: código -->
                <StackPanel x:Name="PanelCodigo" Visibility="Collapsed">
                    <TextBlock Text="Ingresa el código" Style="{StaticResource LblTitulo}"/>
                    <TextBlock x:Name="lblCorreoEnviado" Foreground="#7A7268" FontSize="12"
                               Margin="0,0,0,18" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBox x:Name="d1" Style="{StaticResource CajaCodigo}" TabIndex="0" TextChanged="Digito_TextChanged" PreviewKeyDown="Digito_PreviewKeyDown"/>
                        <TextBox x:Name="d2" Style="{StaticResource CajaCodigo}" TabIndex="1" TextChanged="Digito_TextChanged" PreviewKeyDown="Digito_PreviewKeyDown"/>
                        <TextBox x:Name="d3" Style="{StaticResource CajaCodigo}" TabIndex="2" TextChanged="Digito_TextChanged" PreviewKeyDown="Digito_PreviewKeyDown"/>
                        <TextBox x:Name="d4" Style="{StaticResource CajaCodigo}" TabIndex="3" TextChanged="Digito_TextChanged" PreviewKeyDown="Digito_PreviewKeyDown"/>
                        <TextBox x:Name="d5" Style="{StaticResource CajaCodigo}" TabIndex="4" TextChanged="Digito_TextChanged" PreviewKeyDown="Digito_PreviewKeyDown"/>
                        <TextBox x:Name="d6" Style="{StaticResource CajaCodigo}" TabIndex="5" TextChanged="Digito_TextChanged" PreviewKeyDown="Digito_PreviewKeyDown"/>
                    </StackPanel>
                    <TextBlock x:Name="lblErrorCodigo" Foreground="#C0392B" FontSize="11"
                               Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                    <TextBlock Margin="0,14,0,0" FontSize="12" Foreground="#8B5E3C" Cursor="Hand"
                               TextDecorations="Underline" x:Name="lblReenviar" MouseLeftButtonUp="LblReenviar_Click">
                        Reenviar código
                    </TextBlock>

                    <Grid Margin="0,26,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar" Style="{StaticResource BtnCancelar}" Click="BtnCancelar_Click"/>
                        <Button Grid.Column="2" Content="Verificar" Style="{StaticResource BtnConfirmar}" Click="BtnVerificarCodigo_Click"/>
                    </Grid>
                </StackPanel>

                <!-- PASO 3: nueva contraseña -->
                <StackPanel x:Name="PanelPassword" Visibility="Collapsed">
                    <TextBlock Text="Crea tu nueva contraseña" Style="{StaticResource LblTitulo}"/>

                    <Grid Margin="0,0,0,12">
                        <PasswordBox x:Name="txtPassword1" Style="{StaticResource InputPassword}"/>
                        <TextBox x:Name="txtPassword1Visible" Style="{StaticResource InputBox}" Visibility="Collapsed"/>
                        <ToggleButton x:Name="btnOjo1" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="0,0,8,0" Width="24" Height="24" Background="Transparent" BorderThickness="0"
                      Content="👁" Click="ToggleOjo1_Click"/>
                    </Grid>

                    <Grid>
                        <PasswordBox x:Name="txtPassword2" Style="{StaticResource InputPassword}"/>
                        <TextBox x:Name="txtPassword2Visible" Style="{StaticResource InputBox}" Visibility="Collapsed"/>
                        <ToggleButton x:Name="btnOjo2" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="0,0,8,0" Width="24" Height="24" Background="Transparent" BorderThickness="0"
                      Content="👁" Click="ToggleOjo2_Click"/>
                    </Grid>

                    <TextBlock x:Name="lblErrorPassword" Foreground="#C0392B" FontSize="11"
               Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                    <Grid Margin="0,30,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar" Style="{StaticResource BtnCancelar}" Click="BtnCancelar_Click"/>
                        <Button Grid.Column="2" Content="Confirmar" Style="{StaticResource BtnConfirmar}" Click="BtnConfirmarPassword_Click"/>
                    </Grid>
                </StackPanel>

                <!-- PASO 4: éxito -->
                <StackPanel x:Name="PanelExito" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="¡Contraseña actualizada!" Style="{StaticResource LblTitulo}"
                               HorizontalAlignment="Center" FontSize="15"/>
                    <TextBlock Text="Ya puedes iniciar sesión con tu nueva contraseña."
                               Foreground="#7A7268" FontSize="12" TextAlignment="Center" Margin="0,4,0,20"/>
                    <Button Content="Cerrar" Style="{StaticResource BtnConfirmar}" Width="160"
                            HorizontalAlignment="Center" Click="BtnCancelar_Click"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>