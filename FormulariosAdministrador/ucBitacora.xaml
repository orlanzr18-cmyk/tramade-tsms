<UserControl x:Class="TRAMADE.FormulariosAdministrador.ucBitacora"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#f5f0eb"
             MinHeight="689" MinWidth="963"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>

        <!-- ── Card ─────────────────────────────────────────────────────── -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"   Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding"      Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                      Color="#c8b89a" Opacity="0.15" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TextBox redondeado con placeholder (igual que ucUsuarios) ── -->
        <Style x:Key="TextBoxBuscar" TargetType="TextBox">
            <Setter Property="FontFamily"               Value="Poppins"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Foreground"               Value="#b0a090"/>
            <Setter Property="Background"               Value="#fafafa"/>
            <Setter Property="BorderBrush"              Value="#e0d4c4"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="12,0"/>
            <Setter Property="Height"                   Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"               Value="#3d2b1f"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ComboBox redondeado ──────────────────────────────────────── -->
        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#3d2b1f"/>
            <Setter Property="Background"      Value="#fafafa"/>
            <Setter Property="BorderBrush"     Value="#e0d4c4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="12,0,0,0">
                                    <TextBlock x:Name="Placeholder"
                                               Text="Todos los roles"
                                               FontFamily="Poppins" FontSize="12"
                                               Foreground="#b89870"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed"/>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="⌄" FontSize="14"
                                           Foreground="#8a5c35"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,3"
                                           IsHitTestVisible="False"/>
                                <Popup x:Name="PART_Popup" Grid.ColumnSpan="2"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False"
                                       PopupAnimation="Slide" Placement="Bottom">
                                    <Border Background="White" BorderBrush="#e0d4c4"
                                            BorderThickness="1" CornerRadius="8"
                                            MinWidth="{TemplateBinding ActualWidth}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2"
                                                              Color="#c8b89a" Opacity="0.2" Direction="270"/>
                                        </Border.Effect>
                                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                                <ToggleButton Grid.ColumnSpan="2" Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent" BorderThickness="0" Opacity="0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                            <Trigger Property="SelectedItem" Value="{x:Null}">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite"  Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="FontFamily" Value="Poppins"/>
                        <Setter Property="FontSize"   Value="12"/>
                        <Setter Property="Foreground" Value="#3d2b1f"/>
                        <Setter Property="Padding"    Value="12,7"/>
                        <Setter Property="ToolTip"    Value="{Binding Row[Rol]}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bg" Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#fef4e6"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#fde8c8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DatePicker redondeado ────────────────────────────────────── -->
        <Style x:Key="BrownDatePickerTextBox" TargetType="DatePickerTextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#3d2b1f"/>
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BrownDatePicker" TargetType="DatePicker">
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#3d2b1f"/>
            <Setter Property="Background"      Value="#fafafa"/>
            <Setter Property="BorderBrush"     Value="#e0d4c4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Style="{StaticResource BrownDatePickerTextBox}"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"/>
                                <Button x:Name="PART_Button" Grid.Column="1"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <TextBlock Text="📅" FontSize="13"
                                                           Foreground="#8a5c35"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Popup x:Name="PART_Popup" Grid.ColumnSpan="2"
                                       Placement="Bottom" StaysOpen="False"
                                       AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border Background="White" BorderBrush="#e0d4c4"
                                            BorderThickness="1" CornerRadius="8" Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2"
                                                              Color="#c8b89a" Opacity="0.2" Direction="270"/>
                                        </Border.Effect>
                                        <Calendar x:Name="Calendar"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Botones redondeados ───────────────────────────────────────── -->
        <Style x:Key="BtnAzul" TargetType="Button">
            <Setter Property="Background"      Value="#0f2c83"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="20,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1a48d0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#091a5c"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnCafe" TargetType="Button">
            <Setter Property="Background"      Value="#5c4033"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="20,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#8a5c35"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3a2218"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataGrid ─────────────────────────────────────────────────── -->
        <Style x:Key="DgHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"                 Value="#8a5c35"/>
            <Setter Property="Foreground"                 Value="White"/>
            <Setter Property="FontFamily"                 Value="Poppins"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="FontSize"                   Value="11"/>
            <Setter Property="Padding"                    Value="12,10"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DgCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding"          Value="10,8"/>
            <Setter Property="FontFamily"       Value="Poppins"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="Foreground"       Value="#3d2b1f"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#b29a6f"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Título -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <!-- Card filtros fechas + rol -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <!-- Card buscador + botones -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <!-- Card tabla -->
        </Grid.RowDefinitions>

        <!-- ── Título ── -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Bitácora de Actividades"
                       FontFamily="Poppins" FontSize="22" FontWeight="Bold"
                       Foreground="#3d2b1f"/>
            <TextBlock Text="REGISTRO DE ACTIVIDADES DEL SISTEMA"
                       FontFamily="Poppins" FontSize="10"
                       Foreground="#9a7a5a" FontWeight="Medium"/>
        </StackPanel>

        <!-- ── Card filtros: fechas + rol ── -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Desde" FontFamily="Poppins" FontSize="10"
                               Foreground="#9a7a5a" Margin="0,0,0,4"/>
                    <DatePicker x:Name="dtDesde" Style="{StaticResource BrownDatePicker}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Hasta" FontFamily="Poppins" FontSize="10"
                               Foreground="#9a7a5a" Margin="0,0,0,4"/>
                    <DatePicker x:Name="dtHasta" Style="{StaticResource BrownDatePicker}"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Rol" FontFamily="Poppins" FontSize="10"
                               Foreground="#9a7a5a" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbRol" Style="{StaticResource FilterCombo}"
                              SelectionChanged="cmbRol_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Row[Rol]}"
                                           ToolTip="{Binding Row[Rol]}"
                                           FontFamily="Poppins" FontSize="12"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Card buscador + botones ── -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ── Placeholder real: Text + Tag, igual patrón que ucUsuarios.txtBuscar ── -->
                <TextBox x:Name="txtBuscarUsuario"
                         Grid.Column="0"
                         Style="{StaticResource TextBoxBuscar}"
                         Text="🔍  Buscar por usuario..."
                         Tag="🔍  Buscar por usuario..."
                         GotFocus="txtBuscarUsuario_GotFocus"
                         LostFocus="txtBuscarUsuario_LostFocus"
                         TextChanged="txtBuscarUsuario_TextChanged"/>

                <Button x:Name="btnBuscar" Grid.Column="2"
                        Content="🔍  Buscar"
                        Style="{StaticResource BtnAzul}"
                        Height="40"
                        Click="btnBuscar_Click"/>

                <Button x:Name="btnRefrescar" Grid.Column="4"
                        Content="↻  Refrescar"
                        Style="{StaticResource BtnCafe}"
                        Height="40"
                        Click="btnRefrescar_Click"/>
            </Grid>
        </Border>

        <!-- ── Card tabla ── -->
        <Border Grid.Row="6" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="Registros de actividad"
                               FontFamily="Poppins" FontSize="14" FontWeight="SemiBold"
                               Foreground="#3d2b1f"/>
                    <TextBlock x:Name="lblConteo" Text=""
                               FontFamily="Poppins" FontSize="11"
                               Foreground="#9a7a5a" VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>
                <DataGrid x:Name="dgvBitacora"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#fdf9f5"
                          BorderThickness="0"
                          RowHeaderWidth="0"
                          ColumnHeaderHeight="40"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ColumnHeaderStyle="{StaticResource DgHeaderStyle}"
                          CellStyle="{StaticResource DgCellStyle}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"             Binding="{Binding [ID]}"               Width="0.5*" SortMemberPath="ID"/>
                        <DataGridTextColumn Header="Usuario"        Binding="{Binding [Usuario]}"          Width="1*"   SortMemberPath="Usuario"/>
                        <DataGridTextColumn Header="Rol"             Binding="{Binding [Rol]}"              Width="1*"   SortMemberPath="Rol"/>
                        <DataGridTextColumn Header="Accion"         Binding="{Binding [Accion]}"           Width="3.5*" SortMemberPath="Accion">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping"  Value="Wrap"/>
                                    <Setter Property="TextAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tabla"          Binding="{Binding [Tabla]}"            Width="0.8*" SortMemberPath="Tabla"/>
                        <DataGridTextColumn Header="Fecha de acción" Binding="{Binding [Fecha de acción]}" Width="1.3*" SortMemberPath="Fecha de acción"/>
                    </DataGrid.Columns>

                    <DataGrid.Resources>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#fdf5ea"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#b29a6f"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
