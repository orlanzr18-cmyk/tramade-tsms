<UserControl x:Class="TRAMADE.InventarioControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#f5f0eb">

    <UserControl.Resources>

        <!-- ── Estilos de cards (igual que Dashboard) ── -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"   Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding"      Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                      Color="#c8b89a" Opacity="0.15" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Botones de acción principales ── -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Background"      Value="#8a5c35"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#7a4e2c"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#6a4025"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#c8b8a8"/>
                                <Setter TargetName="Root" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#c0392b"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#a93226"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#922b21"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#c8b8a8"/>
                                <Setter TargetName="Root" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background"   Value="White"/>
            <Setter Property="Foreground"   Value="#8a5c35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                BorderBrush="#daa564" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#fef4e6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#fde8c8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Botones de paginación ── -->
        <Style x:Key="BtnPagina" TargetType="Button">
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Foreground"      Value="#8a5c35"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#fef4e6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#c8b8a8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TextBox de búsqueda con placeholder ── -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#3d2b1f"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#e0d0c0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <!-- Placeholder -->
                                <TextBlock x:Name="Placeholder"
                                           Text="Buscar producto o ID…"
                                           FontFamily="Poppins" FontSize="12"
                                           Foreground="#b89870"
                                           Margin="11,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                            <!-- Mostrar placeholder solo cuando está vacío y sin foco -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="IsFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ComboBox de filtro con template a juego ── -->
        <!-- ── ComboBox de filtro con template a juego ── -->
        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#3d2b1f"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#e0d0c0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>

                                <!-- Placeholder o valor seleccionado -->
                                <Grid Grid.Column="0" Margin="11,0,0,0">
                                    <!-- LÍNEA CORREGIDA: Se agregó Visibility="Collapsed" -->
                                    <TextBlock x:Name="Placeholder"
                                               Text="Ordenar por…"
                                               FontFamily="Poppins" FontSize="12"
                                               Foreground="#b89870"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed"/>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>
                                </Grid>

                                <!-- Flecha -->
                                <TextBlock Grid.Column="1"
                                           Text="⌄" FontSize="14"
                                           Foreground="#8a5c35"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,3"
                                           IsHitTestVisible="False"/>

                                <!-- Popup desplegable -->
                                <Popup x:Name="PART_Popup"
                                       Grid.ColumnSpan="2"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide"
                                       Placement="Bottom">
                                    <Border Background="White"
                                            BorderBrush="#e0d0c0"
                                            BorderThickness="1.5"
                                            CornerRadius="8"
                                            MinWidth="{TemplateBinding ActualWidth}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                                              Color="#c8b89a" Opacity="0.2" Direction="270"/>
                                        </Border.Effect>
                                        <ScrollViewer MaxHeight="200"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>

                                <!-- Área clickeable invisible -->
                                <ToggleButton Grid.ColumnSpan="2"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen,
                                                          Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Opacity="0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                            <!-- Ocultar placeholder cuando hay selección -->
                            <Trigger Property="SelectedItem" Value="{x:Null}">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite"  Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Estilo de cada ítem del dropdown -->
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="FontFamily" Value="Poppins"/>
                        <Setter Property="FontSize"   Value="12"/>
                        <Setter Property="Foreground" Value="#3d2b1f"/>
                        <Setter Property="Padding"    Value="11,7"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bg" Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#fef4e6"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#fde8c8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Header del DataGrid ── -->
        <Style x:Key="DgHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"          Value="#8a5c35"/>
            <Setter Property="Foreground"          Value="White"/>
            <Setter Property="FontFamily"          Value="Poppins"/>
            <Setter Property="FontWeight"          Value="SemiBold"/>
            <Setter Property="FontSize"            Value="11"/>
            <Setter Property="Padding"             Value="12,8"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="SeparatorBrush"      Value="#a07040"/>
            <Setter Property="SeparatorVisibility" Value="Visible"/>
        </Style>

        <!-- ── Celda del DataGrid ── -->
        <Style x:Key="DgCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Foreground"      Value="#3d2b1f"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#fde8c8"/>
                    <Setter Property="Foreground" Value="#3d2b1f"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Fila del DataGrid ── -->
        <Style x:Key="DgRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#fef4e6"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#fdf5ea"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <!-- ══════════════════════════════════════════════════════════════ -->
    <!--  Layout principal                                              -->
    <!-- ══════════════════════════════════════════════════════════════ -->
    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Título + fecha -->
            <RowDefinition Height="Auto"/>
            <!-- Barra de herramientas -->
            <RowDefinition Height="12"/>
            <!-- Espaciador -->
            <RowDefinition Height="*"/>
            <!-- DataGrid (área principal) -->
            <RowDefinition Height="12"/>
            <!-- Espaciador -->
            <RowDefinition Height="Auto"/>
            <!-- Footer: imagen + acciones + paginación -->
        </Grid.RowDefinitions>

        <!-- ── Fila 0: Título y fecha ── -->
        <Grid Grid.Row="0" Margin="2,0,0,10">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="INVENTARIO" FontFamily="Poppins" FontSize="10"
                           Foreground="#9a7a5a" FontWeight="Medium"/>
                <TextBlock x:Name="txtFecha" FontFamily="Poppins" FontSize="12"
                           Foreground="#9a7a5a" Margin="0,2,0,0"/>
            </StackPanel>


        </Grid>

        <!-- ── Fila 1: Barra de herramientas ── -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- Búsqueda -->
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Botón buscar -->
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Botón refrescar -->
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="160"/>
                    <!-- ComboBox filtro -->
                    <ColumnDefinition Width="*"/>
                    <!-- Spacer -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Botones CRUD -->
                </Grid.ColumnDefinitions>

                <!-- Búsqueda -->
                <TextBox Grid.Column="0" x:Name="txtBuscar"
                         Style="{StaticResource SearchBox}"
                         Height="34"
                         Tag="Buscar por nombre o ID…"/>

                <!-- Botón buscar -->
                <Button Grid.Column="2" x:Name="btnBuscar"
                        Style="{StaticResource BtnPrimary}"
                        Width="36" Height="34" Padding="0"
                        Click="btnBuscar_Click"
                        ToolTip="Buscar">
                    <TextBlock Text="🔍" FontSize="14"/>
                </Button>

                <!-- Botón refrescar -->
                <Button Grid.Column="4" x:Name="btnRefrescar"
                        Style="{StaticResource BtnSecondary}"
                        Width="36" Height="34" Padding="0"
                        Click="btnRefrescar_Click"
                        ToolTip="Limpiar filtros">
                    <TextBlock Text="↺" FontSize="16" Foreground="#8a5c35"/>
                </Button>

                <!-- ComboBox de filtro -->
                <ComboBox Grid.Column="6" x:Name="cmbFiltrar"
                          Style="{StaticResource FilterCombo}"
                          SelectionChanged="cmbFiltrar_SelectionChanged">
                    <ComboBoxItem>Orden Alfabético</ComboBoxItem>
                    <ComboBoxItem>Categoría</ComboBoxItem>
                    <ComboBoxItem>Sucursal</ComboBoxItem>
                    <ComboBoxItem>Proveedor</ComboBoxItem>
                    <ComboBoxItem>Mayor Stock</ComboBoxItem>
                    <ComboBoxItem>Menor Stock</ComboBoxItem>
                </ComboBox>

                <!-- Botones CRUD -->
                <StackPanel Grid.Column="8" Orientation="Horizontal">
                    <Button x:Name="btnRegistrar"
                            Style="{StaticResource BtnPrimary}"
                            Height="34" Margin="0,0,8,0"
                            Click="btnRegistrar_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="＋" FontSize="13" Margin="0,0,5,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Registrar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnEditar"
                            Style="{StaticResource BtnSecondary}"
                            Height="34" Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="btnEditar_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✎" FontSize="13" Margin="0,0,5,0"
                                       VerticalAlignment="Center" Foreground="#8a5c35"/>
                            <TextBlock Text="Editar" VerticalAlignment="Center" Foreground="#8a5c35"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnEliminar"
                            Style="{StaticResource BtnDanger}"
                            Height="34"
                            IsEnabled="False"
                            Click="btnEliminar_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕" FontSize="12" Margin="0,0,5,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Eliminar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Fila 3: DataGrid principal ── -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0">
            <DataGrid x:Name="dgInventario"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="False"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#f0e8de"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#fdf9f5"
                      BorderThickness="0"
                      RowHeaderWidth="0"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      ColumnHeaderStyle="{StaticResource DgHeaderStyle}"
                      CellStyle="{StaticResource DgCellStyle}"
                      RowStyle="{StaticResource DgRowStyle}"
                      SelectionChanged="dgInventario_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"         Binding="{Binding ID}"        Width="50"/>
                    <DataGridTextColumn Header="Nombre"     Binding="{Binding Nombre}"    Width="2*"/>
                    <DataGridTextColumn Header="Categoría"  Binding="{Binding Categoría}" Width="1*"/>
                    <DataGridTextColumn Header="Proveedor"  Binding="{Binding Proveedor}" Width="1.6*"/>
                    <DataGridTextColumn Header="Sucursal"   Binding="{Binding Sucursal}"  Width="0.8*"/>
                    <DataGridTextColumn Header="Precio"     Binding="{Binding PrecioStr}" Width="100"/>
                    <DataGridTextColumn Header="Costo"      Binding="{Binding CostoStr}"  Width="100"/>
                    <DataGridTextColumn Header="Stock"      Binding="{Binding Stock}"     Width="60"/>
                    <!-- Columna Alerta se agrega por código según el stock -->
                    <DataGridTemplateColumn Header="Alerta" Width="90" x:Name="colAlerta">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="txtAlerta"
                                           Text="{Binding AlertaTexto}"
                                           Foreground="{Binding AlertaColor}"
                                           FontWeight="SemiBold"
                                           FontFamily="Poppins" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ── Fila 5: Footer ── -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Panel imagen + nombre -->
                <ColumnDefinition Width="*"/>
                <!-- Spacer -->
                <ColumnDefinition Width="Auto"/>
                <!-- Botones exportar -->
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="Auto"/>
                <!-- Paginación -->
            </Grid.ColumnDefinitions>

            <!-- Panel imagen del producto seleccionado -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}"
                    Padding="10" MinWidth="260" MaxWidth="340">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Imagen -->
                    <Border Grid.Column="0" CornerRadius="8" ClipToBounds="True"
                            Width="72" Height="72" Background="#f5f0eb">
                        <Image x:Name="imgProducto"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- Info texto -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="Producto seleccionado" FontFamily="Poppins"
                                   FontSize="10" Foreground="#9a7a5a" Margin="0,0,0,3"/>
                        <TextBlock x:Name="txtNombreProducto"
                                   Text="—"
                                   FontFamily="Poppins" FontSize="13"
                                   FontWeight="SemiBold" Foreground="#3d2b1f"
                                   TextWrapping="Wrap" MaxWidth="160"/>
                        <TextBlock x:Name="txtStockProducto"
                                   FontFamily="Poppins" FontSize="11"
                                   Foreground="#9a7a5a" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Botones de exportación -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="btnExportarTodasEtiquetas"
                        Style="{StaticResource BtnSecondary}"
                        Height="34" Margin="0,0,8,0"
                        IsEnabled="False"
                        Click="btnExportarTodasEtiquetas_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏷" FontSize="13" Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Exportar Etiquetas" VerticalAlignment="Center"
                                   Foreground="#8a5c35"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnExportarInventario"
                        Style="{StaticResource BtnSecondary}"
                        Height="34"
                        Click="btnExportarInventario_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" FontSize="13" Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Exportar Excel" VerticalAlignment="Center"
                                   Foreground="#8a5c35"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Paginación -->
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="6,5">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnAtras"
                            Style="{StaticResource BtnPagina}"
                            Width="24" Height="24"
                            Click="btnAtras_Click">‹</Button>

                    <TextBlock x:Name="lblPagina"
                               Text="Página 1 de 1"
                               FontFamily="Poppins" FontSize="11"
                               Foreground="#8a5c35" FontWeight="Medium"
                               VerticalAlignment="Center"
                               Margin="6,0"/>

                    <Button x:Name="btnSiguiente"
                            Style="{StaticResource BtnPagina}"
                            Width="24" Height="24"
                            Click="btnSiguiente_Click">›</Button>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
