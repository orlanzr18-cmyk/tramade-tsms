<UserControl x:Class="TRAMADE.RegistrarInvControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#4a3325">

    <UserControl.Resources>

        <!-- ── Card blanca central ── -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"   Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding"      Value="28,24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4"
                                      Color="#3d2b1f" Opacity="0.18" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Labels de campo ── -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#8a5c35"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- ── TextBox de campos ── -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#3d2b1f"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#e0d0c0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#f5f0eb"/>
                                <Setter Property="Foreground" Value="#9a7a5a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ComboBox de campos ── -->
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#3d2b1f"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#e0d0c0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="11,0,0,0">

                                    <TextBlock x:Name="Placeholder"
                                               Text="Seleccionar…"
                                               FontFamily="Poppins" FontSize="12"
                                               Foreground="#b89870"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed"/>

                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="⌄" FontSize="14"
                                           Foreground="#8a5c35"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,3"
                                           IsHitTestVisible="False"/>
                                <Popup x:Name="PART_Popup"
                                       Grid.ColumnSpan="2"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide"
                                       Placement="Bottom">
                                    <Border Background="White"
                                            BorderBrush="#e0d0c0"
                                            BorderThickness="1.5"
                                            CornerRadius="8"
                                            MinWidth="{TemplateBinding ActualWidth}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                                              Color="#c8b89a" Opacity="0.2" Direction="270"/>
                                        </Border.Effect>
                                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                                <ToggleButton Grid.ColumnSpan="2" Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent" BorderThickness="0" Opacity="0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"    Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                            <Trigger Property="SelectedItem"   Value="{x:Null}">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="FontFamily" Value="Poppins"/>
                        <Setter Property="FontSize"   Value="12"/>
                        <Setter Property="Foreground" Value="#3d2b1f"/>
                        <Setter Property="Padding"    Value="11,7"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bg" Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#fef4e6"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#fde8c8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ── Botón primario (café) ── -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Background"      Value="#8a5c35"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Padding"         Value="20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#7a4e2c"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#6a4025"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Botón secundario (outline) ── -->
        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#8a5c35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                BorderBrush="#daa564" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#fef4e6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#fde8c8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ══════════════════════════════════════════════════════════════ -->
    <!--  Fondo café con card blanca centrada                          -->
    <!-- ══════════════════════════════════════════════════════════════ -->
    <Grid>
        <!-- Fondo café con patrón sutil -->
        <Grid.Background>
            <SolidColorBrush Color="#8a5c35"/>
        </Grid.Background>

        <!-- Título superior -->
        <TextBlock Text="REGISTRAR PRODUCTO"
                   FontFamily="Poppins" FontSize="18"
                   FontWeight="SemiBold" Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,24,0,0"
                   Opacity="0.9"/>

        <!-- Card central -->
        <Border Style="{StaticResource CardStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="560"
                Margin="0,52,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Fila 1: ID + Precio -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Fila 2: Nombre + Precio Costo -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Fila 3: Proveedor + Stock -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Fila 4: Categoría + Imagen -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Fila 5: Sucursal + Imagen -->
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Fila 6: Botones -->
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Fila 0: ID del Producto + Precio ── -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="ID del Producto" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtIDProducto"
                             Style="{StaticResource FieldBox}"
                             Text="Automático"
                             IsEnabled="False"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="Precio de Venta (L.)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtPrecio" Style="{StaticResource FieldBox}"/>
                </StackPanel>

                <!-- ── Fila 2: Nombre + Precio Costo ── -->
                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="Nombre del Producto" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtNombreProducto" Style="{StaticResource FieldBox}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="Precio de Costo (L.)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtPrecioCosto" Style="{StaticResource FieldBox}"/>
                </StackPanel>

                <!-- ── Fila 4: Proveedor + Stock Inicial ── -->
                <StackPanel Grid.Row="4" Grid.Column="0">
                    <TextBlock Text="Proveedor" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cmbProveedor" Style="{StaticResource FieldCombo}"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="2">
                    <TextBlock Text="Stock Inicial" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtStockInicial" Style="{StaticResource FieldBox}"/>
                </StackPanel>

                <!-- ── Fila 6: Categoría + Imagen ── -->
                <StackPanel Grid.Row="6" Grid.Column="0">
                    <TextBlock Text="Categoría" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cmbCategoria" Style="{StaticResource FieldCombo}"/>
                </StackPanel>

                <!-- Imagen — ocupa columna 2, filas 6 y 8 -->
                <Border Grid.Row="6" Grid.Column="2"
                        Grid.RowSpan="3"
                        CornerRadius="10" ClipToBounds="True"
                        Background="#f5f0eb"
                        BorderBrush="#e0d0c0" BorderThickness="1.5">
                    <Grid>
                        <!-- Placeholder cuando no hay imagen -->
                        <StackPanel x:Name="pnlPlaceholderImg"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="🖼" FontSize="32"
                                       HorizontalAlignment="Center"
                                       Foreground="#c8b8a8"/>
                            <TextBlock Text="Sin imagen" FontFamily="Poppins"
                                       FontSize="11" Foreground="#b89870"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <Image x:Name="imgProducto"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>

                <!-- ── Fila 8: Sucursal + botón subir imagen ── -->
                <StackPanel Grid.Row="8" Grid.Column="0">
                    <TextBlock x:Name="txtSucursal"
                               Style="{StaticResource FieldLabel}"
                               FontSize="12" Foreground="#9a7a5a"/>
                </StackPanel>

                <Button Grid.Row="8" Grid.Column="2"
                        x:Name="btnSubir"
                        Style="{StaticResource BtnSecondary}"
                        Height="32" Padding="12,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Click="btnSubir_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁" FontSize="12" Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Subir imagen" VerticalAlignment="Center"
                                   Foreground="#8a5c35"/>
                    </StackPanel>
                </Button>

                <!-- ── Fila 10: Botones ── -->
                <StackPanel Grid.Row="10" Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="btnCancelar"
                            Style="{StaticResource BtnSecondary}"
                            Content="Cancelar"
                            Padding="24,0"
                            Margin="0,0,10,0"
                            Click="btnCancelar_Click"/>
                    <Button x:Name="btnRegistrar"
                            Style="{StaticResource BtnPrimary}"
                            Padding="24,0"
                            Click="btnRegistrar_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" FontSize="13" Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Registrar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>
