<UserControl x:Class="TRAMADE.FormulariosDeudor.wndAgregarPago"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#8a5c35">

    <UserControl.Resources>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"   Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding"      Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                      Color="#c8b89a" Opacity="0.15" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LblCampo" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#3d2b1f"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <Style x:Key="CampoValor" TargetType="Border">
            <Setter Property="Background"      Value="#f2fbf2"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="12,10"/>
            <Setter Property="BorderBrush"     Value="#c8c8c8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin"          Value="0,0,0,16"/>
        </Style>

        <!-- TextBox con bordes redondeados -->
        <Style x:Key="TextBoxRedondeado" TargetType="TextBox">
            <Setter Property="FontFamily"             Value="Poppins"/>
            <Setter Property="FontSize"               Value="16"/>
            <Setter Property="Foreground"             Value="#3d2b1f"/>
            <Setter Property="Background"             Value="#f5f3f0"/>
            <Setter Property="BorderBrush"            Value="#c8c8c8"/>
            <Setter Property="BorderThickness"        Value="1"/>
            <Setter Property="Padding"                Value="12,0"/>
            <Setter Property="Height"                 Value="46"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"             Value="#3d2b1f"/>
            <Setter Property="Margin"                 Value="0,0,0,16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#0f2c83"/>
                                <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#8a5c35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnAzul" TargetType="Button">
            <Setter Property="Background"      Value="#0f2c83"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="20,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#8080ff"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#091a5c"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnNeutro" TargetType="Button">
            <Setter Property="Background"      Value="#ede8e2"/>
            <Setter Property="Foreground"      Value="#3d2b1f"/>
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="20,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#d8d0c6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Agregar Pago"
                       FontFamily="Poppins" FontSize="22" FontWeight="Bold"
                       Foreground="White"/>
            <TextBlock Text="REGISTRAR ABONO DE DEUDA"
                       FontFamily="Poppins" FontSize="10"
                       Foreground="#f0e0cc" FontWeight="Medium"/>
        </StackPanel>

        <!-- Card -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Deudor -->
                <TextBlock Grid.Row="0"
                           Text="Deudor"
                           Style="{StaticResource LblCampo}"/>
                <Border Grid.Row="1" Style="{StaticResource CampoValor}">
                    <TextBlock x:Name="lblDeudor"
                               FontFamily="Poppins" FontSize="14"
                               Foreground="#3d2b1f" FontWeight="SemiBold"/>
                </Border>

                <!-- Saldo pendiente -->
                <TextBlock Grid.Row="2"
                           Text="Saldo pendiente"
                           Style="{StaticResource LblCampo}"/>
                <Border Grid.Row="3" Style="{StaticResource CampoValor}">
                    <TextBlock x:Name="txtSaldoPendiente"
                               FontFamily="Poppins" FontSize="14"
                               Foreground="#2e7d52" FontWeight="SemiBold"/>
                </Border>

                <!-- Monto a pagar -->
                <TextBlock Grid.Row="4"
                           Text="Monto a pagar"
                           Style="{StaticResource LblCampo}"/>
                <TextBox Grid.Row="5"
                         x:Name="txtMontoPagar"
                         Style="{StaticResource TextBoxRedondeado}"
                         TextChanged="txtMontoPagar_TextChanged"/>

                <!-- Separador -->
                <Border Grid.Row="6"
                        Background="#e0d4c4"
                        Height="1"
                        Margin="0,0,0,16"/>

                <!-- Botones -->
                <Grid Grid.Row="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnCancelar"
                            Grid.Column="0"
                            Content="✖  Cancelar"
                            Style="{StaticResource BtnNeutro}"
                            Height="44"
                            Click="btnCancelar_Click"/>

                    <Button x:Name="btnConfirmar"
                            Grid.Column="2"
                            Content="✅  Confirmar pago"
                            Style="{StaticResource BtnAzul}"
                            Height="44"
                            Click="btnConfirmar_Click"/>
                </Grid>

            </Grid>
        </Border>

    </Grid>
</UserControl>