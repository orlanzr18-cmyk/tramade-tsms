<UserControl x:Class="TRAMADE.FormulariosDeudor.ucDeudor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#f5f0eb"
             Loaded="UserControl_Loaded" Height="671" Width="1488">

    <UserControl.Resources>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"   Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding"      Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                      Color="#c8b89a" Opacity="0.15" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnAzul" TargetType="Button">
            <Setter Property="Background"      Value="#1348e5"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="20,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#8080ff"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0a2ea0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DgHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"          Value="#8a5c35"/>
            <Setter Property="Foreground"          Value="White"/>
            <Setter Property="FontFamily"          Value="Poppins"/>
            <Setter Property="FontWeight"          Value="SemiBold"/>
            <Setter Property="FontSize"            Value="11"/>
            <Setter Property="Padding"             Value="12,8"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DgCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Foreground"      Value="#3d2b1f"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#b29a6f"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo especial para celda Estado VENCIDO / AL DÍA -->
        <Style x:Key="EstadoCellStyle" TargetType="DataGridCell"
               BasedOn="{StaticResource DgCellStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Estado}" Value="VENCIDO">
                    <Setter Property="Foreground" Value="#c0392b"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="AL DÍA">
                    <Setter Property="Foreground" Value="#2e7d52"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Título -->
            <RowDefinition Height="Auto"/>
            <!-- Botón + Buscador -->
            <RowDefinition Height="*"/>
            <!-- Tabla -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════
             FILA 0 — Título
        ══════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Listado de Deudores"
                           FontFamily="Poppins" FontSize="22" FontWeight="Bold"
                           Foreground="#3d2b1f"/>
                <TextBlock Text="CLIENTES CON SALDO PENDIENTE"
                           FontFamily="Poppins" FontSize="10"
                           Foreground="#9a7a5a" FontWeight="Medium"/>
            </StackPanel>
        </Grid>

        <!-- ══════════════════════════════════════════
             FILA 1 — Botón + Buscador
        ══════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Botón registrar pago -->
                <Button x:Name="btnRegistrarPago"
                        Grid.Column="0"
                        Content="💳  Registrar pago"
                        Style="{StaticResource BtnAzul}"
                        Margin="0,0,16,0"
                        Click="btnRegistrarPago_Click"/>

                <!-- Buscador con placeholder -->
                <Grid Grid.Column="1">
                    <TextBox x:Name="txtBuscar"
                             FontFamily="Poppins" FontSize="12"
                             Foreground="#b0a090"
                             Background="#fafafa"
                             BorderBrush="#e0d4c4"
                             BorderThickness="1"
                             Padding="12,8"
                             VerticalContentAlignment="Center"
                             Text="Buscar por Cliente, DNI o RTN..."
                             GotFocus="txtBuscar_GotFocus"
                             LostFocus="txtBuscar_LostFocus"
                             Tag="Buscar por Cliente, DNI o RTN..."
                             TextChanged="txtBuscar_TextChanged" Margin="0,1,0,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <!-- Icono de búsqueda -->
                    <TextBlock Text="🔍" FontSize="14"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════
             FILA 2 — Tabla de deudores
        ══════════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16,14">
            <DataGrid x:Name="dgvDeudor"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          CanUserSortColumns="True"
          CanUserReorderColumns="False"
          HeadersVisibility="Column"
          GridLinesVisibility="Horizontal"
          HorizontalGridLinesBrush="#f0e8de"
          Background="White"
          RowBackground="White"
          AlternatingRowBackground="#fdf9f5"
          BorderThickness="0"
          RowHeaderWidth="0"
          SelectionMode="Single"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ColumnHeaderStyle="{StaticResource DgHeaderStyle}"
          CellStyle="{StaticResource DgCellStyle}">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cliente"
                            Binding="{Binding Cliente}"
                            Width="2*"/>
                    <DataGridTextColumn Header="DNI"
                            Binding="{Binding DNI}"
                            Width="*"/>
                    <DataGridTextColumn Header="RTN"
                            Binding="{Binding RTN}"
                            Width="*"/>
                    <DataGridTextColumn Header="Deuda base"
                            Binding="{Binding DeudaBase}"
                            Width="2*"/>
                    <DataGridTextColumn Header="Mora"
                            Binding="{Binding Mora}"
                            Width="*"/>
                    <DataGridTextColumn Header="Deuda total"
                            Binding="{Binding DeudaTotal}"
                            Width="2*"/>
                    <DataGridTextColumn Header="Total pagado"
                            Binding="{Binding TotalPagado}"
                            Width="2*"/>
                    <DataGridTextColumn Header="Saldo pendiente"
                            Binding="{Binding SaldoPendiente}"
                            Width="2*"/>
                    <DataGridTextColumn Header="Estado"
                            Binding="{Binding Estado}"
                            Width="*"
                            CellStyle="{StaticResource EstadoCellStyle}"/>
                </DataGrid.Columns>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#b29a6f"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#fdf5ea"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>