<UserControl x:Class="TRAMADE.Formulario_Reporte.ucReportes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="689"
             d:DesignWidth="963"
             MinHeight="689"
             MinWidth="963"
             Background="#f5f0eb">

    <UserControl.Resources>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  Cards (igual que Inventario)                              -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"   Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding"      Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                      Color="#c8b89a" Opacity="0.15" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  Tipografía                                                -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Poppins"/>
        </Style>

        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#3d2b1f"/>
        </Style>

        <Style x:Key="EyebrowText" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#9a7a5a"/>
        </Style>

        <Style x:Key="SubTitleText" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#3d2b1f"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#9a7a5a"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  Botones -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Background"      Value="#8a5c35"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#7a4e2c"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#6a4025"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#c8b8a8"/>
                                <Setter TargetName="Root" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#c0392b"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#a93226"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#922b21"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#c8b8a8"/>
                                <Setter TargetName="Root" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#8a5c35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                BorderBrush="#daa564" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#fef4e6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#fde8c8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  ComboBox con borde café / interior blanco                 -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#3d2b1f"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"      Value="#e0d0c0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height"          Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="11,0,0,0">
                                    <TextBlock x:Name="Placeholder"
                                               Text="Seleccionar…"
                                               FontFamily="Poppins" FontSize="12"
                                               Foreground="#b89870"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed"/>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>
                                </Grid>

                                <TextBlock Grid.Column="1"
                                           Text="⌄" FontSize="14"
                                           Foreground="#8a5c35"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,3"
                                           IsHitTestVisible="False"/>

                                <Popup x:Name="PART_Popup"
                                       Grid.ColumnSpan="2"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide"
                                       Placement="Bottom">
                                    <Border Background="White"
                                            BorderBrush="#e0d0c0"
                                            BorderThickness="1.5"
                                            CornerRadius="8"
                                            MinWidth="{TemplateBinding ActualWidth}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                                              Color="#c8b89a" Opacity="0.2" Direction="270"/>
                                        </Border.Effect>
                                        <ScrollViewer MaxHeight="200"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>

                                <ToggleButton Grid.ColumnSpan="2"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen,
                                                          Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Opacity="0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                            <Trigger Property="SelectedItem" Value="{x:Null}">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="FontFamily" Value="Poppins"/>
                        <Setter Property="FontSize"   Value="12"/>
                        <Setter Property="Foreground" Value="#3d2b1f"/>
                        <Setter Property="Padding"    Value="11,7"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bg" Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#fef4e6"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#fde8c8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  DatePicker con borde café / interior blanco                -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Style x:Key="BrownDatePickerTextBox" TargetType="DatePickerTextBox">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#3d2b1f"/>
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Border Background="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BrownDatePicker" TargetType="DatePicker">
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#3d2b1f"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"      Value="#e0d0c0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height"          Value="38"/>
            <Setter Property="CalendarStyle">
                <Setter.Value>
                    <Style TargetType="Calendar">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="#e0d0c0"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="FontFamily" Value="Poppins"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>

                                <DatePickerTextBox x:Name="PART_TextBox"
                                                    Grid.Column="0"
                                                    Style="{StaticResource BrownDatePickerTextBox}"
                                                    Margin="11,0,0,0"
                                                    VerticalAlignment="Center"/>

                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <TextBlock Text="📅"
                                                           FontSize="13"
                                                           Foreground="#8a5c35"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Popup x:Name="PART_Popup"
                                       Grid.ColumnSpan="2"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Slide">
                                    <Border Background="White"
                                            BorderBrush="#e0d0c0"
                                            BorderThickness="1.5"
                                            CornerRadius="8"
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                                              Color="#c8b89a" Opacity="0.2" Direction="270"/>
                                        </Border.Effect>
                                        <Calendar x:Name="Calendar"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  DataGrid (estilo Inventario)                              -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Style x:Key="DgHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"          Value="#8a5c35"/>
            <Setter Property="Foreground"          Value="White"/>
            <Setter Property="FontFamily"          Value="Poppins"/>
            <Setter Property="FontWeight"          Value="SemiBold"/>
            <Setter Property="FontSize"            Value="11"/>
            <Setter Property="Padding"             Value="12,8"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="SeparatorBrush"      Value="#a07040"/>
            <Setter Property="SeparatorVisibility" Value="Visible"/>
        </Style>

        <Style x:Key="DgCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Foreground"      Value="#3d2b1f"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#fde8c8"/>
                    <Setter Property="Foreground" Value="#3d2b1f"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DgRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#fef4e6"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#fdf5ea"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <!-- ══════════════════════════════════════════════════════════════ -->
    <!--  Layout principal                                              -->
    <!-- ══════════════════════════════════════════════════════════════ -->
    <Grid Margin="16,12,16,12"
      FocusManager.FocusedElement="{Binding ElementName=DummyFocus}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Título -->
            <RowDefinition Height="Auto"/>
            <!-- Panel de configuración -->
            <RowDefinition Height="12"/>
            <!-- Espaciador -->
            <RowDefinition Height="*"/>
            <!-- Lista de reportes + panel lateral -->
        </Grid.RowDefinitions>

        <!-- ── Fila 0: Título ── -->
        <Grid Grid.Row="0" Margin="2,0,0,12">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock x:Name="txtTitulo"
                           Text="Módulo de Reportes"
                           Style="{StaticResource TitleText}"
                           Margin="0,2,0,0"
                           Focusable="True"/>
            </StackPanel>
        </Grid>

        <!-- ── Fila 1: Panel de configuración ── -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Panel de Configuración de Reportes"
                           Style="{StaticResource SubTitleText}"
                           Margin="0,0,0,16"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Desde" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="dpDesde"
                                    Style="{StaticResource BrownDatePicker}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Hasta" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="dpHasta"
                                    Style="{StaticResource BrownDatePicker}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Sucursal" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbSucursal"
                                  Style="{StaticResource FilterCombo}"
                                  DisplayMemberPath="Nombre"
                                  SelectedValuePath="Id"
                                  TextSearch.TextPath="Nombre"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Tipo de reporte" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbTipoReporte"
                                  Style="{StaticResource FilterCombo}"
                                  SelectionChanged="cmbTipoReporte_SelectionChanged"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ── Fila 3: Lista de reportes + panel lateral ── -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <!-- Reportes generados -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Reportes Generados"
                               Style="{StaticResource SubTitleText}"
                               Margin="0,0,0,14"/>

                    <DataGrid x:Name="dgvReportes"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="False"
                              CanUserSortColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#f0e8de"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#fdf9f5"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              RowHeight="38"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              ColumnHeaderStyle="{StaticResource DgHeaderStyle}"
                              CellStyle="{StaticResource DgCellStyle}"
                              RowStyle="{StaticResource DgRowStyle}"
                              MouseDoubleClick="dgvReportes_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre del Reporte"
                                                 Binding="{Binding Reporte}"
                                                 Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Panel lateral: formato + acciones -->
            <StackPanel Grid.Column="2">

                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Generar Reporte"
                   Style="{StaticResource SubTitleText}"
                   Margin="0,0,0,14"/>

                        <Button x:Name="btnGenerar"
                Style="{StaticResource BtnPrimary}"
                Height="38"
                HorizontalAlignment="Stretch"
                Click="btnGenerar_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="＋" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Generar reporte" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Formato de descarga"
                                   Style="{StaticResource SubTitleText}"
                                   Margin="0,0,0,14"/>

                        <TextBlock Text="Seleccionar formato" Style="{StaticResource FieldLabel}"/>

                        <ComboBox x:Name="cmbFormato"
                                  Style="{StaticResource FilterCombo}"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Acciones"
                                   Style="{StaticResource SubTitleText}"
                                   Margin="0,0,0,14"/>

                        <Button x:Name="btnDescargar"
                                Style="{StaticResource BtnPrimary}"
                                Height="38"
                                Margin="0,0,0,10"
                                Click="btnDescargar_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⬇" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Descargar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnEliminar"
                                Style="{StaticResource BtnDanger}"
                                Height="38"
                                Click="btnEliminar_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✕" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Eliminar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
