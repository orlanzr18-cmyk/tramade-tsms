<Window x:Class="TRAMADE.FormulariosCompras.AutorizarCompraControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="1010" Height="710"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinWidth="1010" MinHeight="710"
        Background="#8A5C35"
        Loaded="UserControl_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ComprasStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="AUTORIZAR SOLICITUD DE COMPRA"
                   FontFamily="Poppins" FontSize="18"
                   FontWeight="SemiBold" Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,18,0,0"
                   Opacity="0.9"/>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="28,0,28,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,16" HorizontalAlignment="Left">
                    <TextBlock Text="Numero de compra" Style="{StaticResource FieldLabel}"/>
                    <Grid Width="316">
                        <TextBox x:Name="TxtBuscar"
                                 TextChanged="TxtBuscar_TextChanged"/>
                        <Popup x:Name="PopupCompras"
                               PlacementTarget="{Binding ElementName=TxtBuscar}"
                               Placement="Bottom"
                               Width="{Binding ActualWidth, ElementName=TxtBuscar}"
                               StaysOpen="False">
                            <Border Background="White"
                                    BorderBrush="#E0D0C0"
                                    BorderThickness="1.5"
                                    CornerRadius="8"
                                    MaxHeight="180">
                                <ListBox x:Name="LstCompras"
                                         BorderThickness="0"
                                         FontFamily="Poppins"
                                         FontSize="11"
                                         SelectionChanged="LstCompras_SelectionChanged"/>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <Border Grid.Row="1" Background="#E0D0C0"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,12">
                    <Button Style="{StaticResource SuccessButton}"
                            Content="AUTORIZAR SELECCIONES"
                            Margin="0,0,8,0"
                            Click="BtnAutorizar_Click"/>
                    <Button Style="{StaticResource DangerButton}"
                            Content="DENEGAR SELECCIONES"
                            Click="BtnDenegar_Click"/>
                </StackPanel>

                <Border Grid.Row="3"
                        Background="White"
                        BorderBrush="#E0D0C0"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Padding="2">
                    <DataGrid x:Name="DgCompras"
                              IsReadOnly="False"
                              CanUserResizeColumns="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              RowHeight="32"
                              ColumnHeaderHeight="48"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              FontFamily="Poppins"
                              FontSize="10"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
