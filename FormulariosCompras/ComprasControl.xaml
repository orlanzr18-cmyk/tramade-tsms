<UserControl x:Class="TRAMADE.FormulariosCompras.ComprasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             FontFamily="Poppins"
             Background="White"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ComprasStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="58"/>
            <RowDefinition Height="242"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="1" Rows="1" Columns="4">
            <Button Margin="0,0,8,0" Background="#D65243"
                    Content="✚  REGISTRAR SOLICITUD" Click="BtnRegistrar_Click" Height="52"/>
            <Button  x:Name="btnActualizar" Margin="0,0,8,0" Background="#9A6075"
                    Content="⟳  ACTUALIZAR SOLICITUD" Click="BtnActualizar_Click" Height="52"/>
            <Button  x:Name="btnAutorizar" Margin="0,0,8,0" Background="#5B9668"
                    Content="▣  AUTORIZAR SOLICITUD" Click="BtnAutorizar_Click" Height="52"/>
            <Button Margin="0,0,8,0" Background="#A59763"
                    Content="⌕  SEGUIMIENTO DE COMPRA" Click="BtnSeguimiento_Click" Height="52"/>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="28,18,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.18*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1.18*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="0.88*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="10"
                    BorderBrush="#EFE8E0" BorderThickness="1" Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1"
                                      Opacity="0.12" Color="#8C6C47"/>
                </Border.Effect>
                <oxy:PlotView x:Name="PlotProductos" Background="White"/>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="10"
                    BorderBrush="#EFE8E0" BorderThickness="1" Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1"
                                      Opacity="0.12" Color="#8C6C47"/>
                </Border.Effect>
                <oxy:PlotView x:Name="PlotProveedores" Background="White"/>
            </Border>
            <Border Grid.Column="4" Background="White" CornerRadius="10"
                    BorderBrush="#EFE8E0" BorderThickness="1" Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1"
                                      Opacity="0.12" Color="#8C6C47"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>
                    <oxy:PlotView x:Name="PlotEstados" Background="White"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Rectangle Width="20" Height="10" Fill="#D2A86E" Margin="0,0,5,0"/>
                        <TextBlock Text="Pendientes" FontSize="10" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Rectangle Width="20" Height="10" Fill="#48C7AE" Margin="0,0,5,0"/>
                        <TextBlock Text="Autorizadas" FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="COMPRAS RECIENTES"
                   FontFamily="Poppins" FontSize="17" FontWeight="SemiBold"
                   Foreground="Black" Margin="5,12,0,8"/>

        <DataGrid Grid.Row="4" x:Name="DgRecientes"
                  IsReadOnly="True"
                  CanUserResizeColumns="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="False"
                  SelectionMode="Single"
                  RowHeight="35"
                  ColumnHeaderHeight="35"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  BorderThickness="0"
                  GridLinesVisibility="None"
                  FontFamily="Poppins"
                  FontSize="10.5"/>
    </Grid>
</UserControl>
