<Window x:Class="TRAMADE.FormulariosCompras.SeguimientoCompraControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="1005" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinWidth="1005" MinHeight="720"
        Background="#8A5C35"
        Loaded="UserControl_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ComprasStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="SEGUIMIENTO DE SOLICITUD DE COMPRAS"
                   FontFamily="Poppins" FontSize="18"
                   FontWeight="SemiBold" Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,18,0,0"
                   Opacity="0.9"/>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="28,0,28,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="104"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="1.10*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#77B6D5" CornerRadius="10" Padding="14">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Viewbox Width="30" Height="30" Margin="0,0,18,0"
                                     VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="#111111" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent"
                                          Data="M 2,3 L 5,3 L 7,14 L 18,14 L 20,6 L 6,6 M 8,18 A 1.6,1.6 0 1 0 8,21 A 1.6,1.6 0 1 0 8,18 M 17,18 A 1.6,1.6 0 1 0 17,21 A 1.6,1.6 0 1 0 17,18"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center" MinWidth="150">
                                <TextBlock Text="Solicitudes registradas"
                                           FontFamily="Poppins" FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                                <TextBlock x:Name="TxtSolicitudes" Text="0"
                                           FontFamily="Poppins" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#C3A052" CornerRadius="10" Padding="14">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Viewbox Width="30" Height="30" Margin="0,0,18,0"
                                     VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Width="19" Height="13" Canvas.Left="2.5" Canvas.Top="5.5"
                                               Stroke="#111111" StrokeThickness="1.8"
                                               RadiusX="1.5" RadiusY="1.5"/>
                                    <Ellipse Width="6" Height="6" Canvas.Left="9" Canvas.Top="9"
                                             Stroke="#111111" StrokeThickness="1.6"/>
                                    <Line X1="5" Y1="8" X2="7" Y2="8"
                                          Stroke="#111111" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                    <Line X1="17" Y1="16" X2="19" Y2="16"
                                          Stroke="#111111" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center" MinWidth="150">
                                <TextBlock Text="Valor total pendiente"
                                           FontFamily="Poppins" FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                                <TextBlock x:Name="TxtValor" Text="L 0.00"
                                           FontFamily="Poppins" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="#278542" CornerRadius="10" Padding="14">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Viewbox Width="30" Height="30" Margin="0,0,18,0"
                                     VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Ellipse Width="18" Height="18" Canvas.Left="3" Canvas.Top="3"
                                             Stroke="#111111" StrokeThickness="1.8"/>
                                    <Line X1="12" Y1="7" X2="12" Y2="12"
                                          Stroke="#111111" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                    <Line X1="12" Y1="12" X2="16" Y2="14"
                                          Stroke="#111111" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center" MinWidth="175">
                                <TextBlock Text="Tiempo de respuesta promedio"
                                           FontFamily="Poppins" FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                                <TextBlock x:Name="TxtTiempo" Text="0 dias"
                                           FontFamily="Poppins" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="1" Text="PERIODO Y BUSQUEDA"
                           FontFamily="Poppins" FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#3D2B1F"
                           VerticalAlignment="Center"/>

                <Grid Grid.Row="2" Margin="0,0,62,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="38"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Fecha inicio" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="DpDesde"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Fecha fin" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="DpHasta"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Numero de compra" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <TextBox x:Name="TxtId"
                                     TextChanged="TxtId_TextChanged"/>
                            <Popup x:Name="PopupCompras"
                                   PlacementTarget="{Binding ElementName=TxtId}"
                                   Placement="Bottom"
                                   Width="{Binding ActualWidth, ElementName=TxtId}"
                                   StaysOpen="False">
                                <Border Background="White"
                                        BorderBrush="#E0D0C0"
                                        BorderThickness="1.5"
                                        CornerRadius="8"
                                        MaxHeight="180">
                                    <ListBox x:Name="LstCompras"
                                             BorderThickness="0"
                                             FontFamily="Poppins"
                                             FontSize="11"
                                             SelectionChanged="LstCompras_SelectionChanged"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                    <Button Grid.Column="6" VerticalAlignment="Bottom" Background="#15318E"
                            Content="Buscar" Click="BtnBuscar_Click"/>
                    <Button Grid.Column="8" VerticalAlignment="Bottom"
                            Style="{StaticResource SecondaryButton}"
                            Width="36"
                            Height="34"
                            Padding="0"
                            ToolTip="Reiniciar busqueda"
                            Click="BtnRecargar_Click">
                        <Viewbox Width="16" Height="16">
                            <Path Stroke="#3D2B1F"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Data="M 15,5 A 6,6 0 1 0 16,12 M 15,5 L 15,1 M 15,5 L 11,5"/>
                        </Viewbox>
                    </Button>
                </Grid>

                <Border Grid.Row="3"
                        Background="White"
                        BorderBrush="#E0D0C0"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Padding="2">
                    <DataGrid x:Name="DgSeguimiento"
                              IsReadOnly="True"
                              CanUserResizeColumns="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              RowHeight="32"
                              ColumnHeaderHeight="48"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              FontFamily="Poppins"
                              FontSize="9.5"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
