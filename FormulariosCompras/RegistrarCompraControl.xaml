<Window x:Class="TRAMADE.FormulariosCompras.RegistrarCompraControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        Title=""
        Width="845" Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinWidth="760" MinHeight="680"
        Background="#4a3325"
        Loaded="UserControl_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ComprasStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"   Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding"      Value="28,24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4"
                                      Color="#3d2b1f" Opacity="0.18" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#8a5c35"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#3d2b1f"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#e0d0c0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Height"          Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter Property="Background" Value="#f5f0eb"/>
                                <Setter Property="Foreground" Value="#a9a9a9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#3d2b1f"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#e0d0c0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="11,0,0,0">
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Visibility="Hidden"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             VerticalAlignment="Center"
                                             IsReadOnly="{TemplateBinding IsReadOnly}"
                                             Focusable="{TemplateBinding IsEditable}"/>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="&#x2304;" FontSize="14"
                                           Foreground="#8a5c35" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <Popup x:Name="PART_Popup" Grid.ColumnSpan="2"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False"
                                       PopupAnimation="Slide" Placement="Bottom">
                                    <Border Background="White" BorderBrush="#e0d0c0"
                                            BorderThickness="1.5" CornerRadius="8"
                                            MinWidth="{TemplateBinding ActualWidth}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                                              Color="#c8b89a" Opacity="0.2" Direction="270"/>
                                        </Border.Effect>
                                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                                <ToggleButton Grid.Column="1" Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent" BorderThickness="0" Opacity="0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"    Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#daa564"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="FontFamily" Value="Poppins"/>
                        <Setter Property="FontSize"   Value="12"/>
                        <Setter Property="Foreground" Value="#3d2b1f"/>
                        <Setter Property="Padding"    Value="11,7"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bg" Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#fef4e6"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#fde8c8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Background"      Value="#8a5c35"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#7a4e2c"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#6a4025"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#8a5c35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                BorderBrush="#daa564" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#fef4e6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#fde8c8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#c0392b"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#a93226"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#922b21"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSuccess" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#27ae60"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#219a52"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1a7a42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid liviano, estilo "card" -->
        <Style x:Key="DetalleGrid" TargetType="DataGrid">
            <Setter Property="FontFamily"               Value="Poppins"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Foreground"               Value="#3d2b1f"/>
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="GridLinesVisibility"      Value="None"/>
            <Setter Property="HeadersVisibility"        Value="Column"/>
            <Setter Property="RowHeight"                Value="34"/>
            <Setter Property="ColumnHeaderHeight"       Value="34"/>
            <Setter Property="CanUserAddRows"           Value="False"/>
            <Setter Property="CanUserDeleteRows"        Value="False"/>
            <Setter Property="CanUserReorderColumns"    Value="False"/>
            <Setter Property="RowBackground"            Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#fef9f3"/>
            <Setter Property="VerticalGridLinesBrush"   Value="Transparent"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#f0e6da"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#8a5c35"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontFamily"      Value="Poppins"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SeparatorBrush"  Value="#a07040"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#fde8c8"/>
                    <Setter Property="Foreground" Value="#3d2b1f"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="#8a5c35"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="REGISTRO DE SOLICITUD DE COMPRAS"
                   FontFamily="Poppins" FontSize="18"
                   FontWeight="SemiBold" Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,18,0,0"
                   Opacity="0.9"/>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="28,0,28,14"
                Padding="28,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="*" MinHeight="90"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Fila 0: Proveedor + Fecha de entrega -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Proveedor" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbProveedor" IsEditable="True"
                                  Style="{StaticResource FieldCombo}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Fecha de entrega" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="DpEntrega" Style="{StaticResource FieldDatePicker}"/>
                    </StackPanel>
                </Grid>

                <!-- Fila 2: Forma de pago -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="Forma de pago" Style="{StaticResource FieldLabel}"/>
                    <!-- DisplayMemberPath y SelectedValuePath se asignan en el code-behind
                         (CargarCombo: "descripcion_forma_pago" / "id_forma_pago"), no es
                         necesario fijarlos aquí en el XAML. -->
                    <ComboBox x:Name="CmbFormaPago" Style="{StaticResource FieldCombo}"
                              HorizontalAlignment="Left" Width="280"/>
                </StackPanel>

                <!-- Fila 4: separador -->
                <Border Grid.Row="4" Background="#e0d0c0"/>

                <!-- Fila 6: Selección de producto -->
                <StackPanel Grid.Row="6">
                    <TextBlock Text="Agregar producto a la solicitud" Style="{StaticResource SectionLabel}"/>
                </StackPanel>

                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Seleccione el producto" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbProducto" IsEditable="True"
                                  Style="{StaticResource FieldCombo}"
                                  SelectionChanged="CmbProducto_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <Button x:Name="BtnAgregar"
                                Style="{StaticResource BtnSuccess}"
                                Height="38" MinWidth="108" Padding="20,0"
                                Click="BtnAgregar_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+" FontSize="14" Margin="0,0,5,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Agregar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                        <Button x:Name="BtnQuitar"
                                Style="{StaticResource BtnDanger}"
                                Height="38" MinWidth="96" Padding="20,0"
                                Click="BtnQuitar_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="x" FontSize="12" Margin="0,0,5,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Quitar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Fila 10: Precio costo + Cantidad -->
                <Grid Grid.Row="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Precio de costo" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtPrecio" IsReadOnly="True"
                                 Style="{StaticResource FieldBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Cantidad" Style="{StaticResource FieldLabel}"/>
                        <Border BorderBrush="#e0d0c0" BorderThickness="1.5"
                                CornerRadius="8" Background="White" Height="34">
                            <wfi:WindowsFormsHost Margin="2">
                                <wf:NumericUpDown x:Name="NudCantidad"
                                                   Minimum="1" Maximum="100" Value="1"
                                                   BorderStyle="None"/>
                            </wfi:WindowsFormsHost>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Fila 12: Productos agregados -->
                <Grid Grid.Row="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Productos agregados" Style="{StaticResource FieldLabel}"/>
                        <Border Grid.Row="1"
                                Background="White"
                                BorderBrush="#e0d0c0" BorderThickness="1.5"
                                CornerRadius="8" Padding="2">
                            <!-- AutoGenerateColumns="False": antes estaba en True (por defecto)
                                 y por eso salían columnas crudas y duplicadas (idProducto,
                                 nombreProducto, cantidad, precioCosto...). Ajusta los Binding
                                 de abajo si el nombre real de tus propiedades es distinto. -->
                            <DataGrid x:Name="DgDetalle"
                                      Style="{StaticResource DetalleGrid}"
                                      AutoGenerateColumns="False"
                                      SelectionChanged="DgDetalle_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Producto"
                                                         Binding="{Binding nombreProducto}"
                                                         Width="2.4*"/>
                                    <DataGridTextColumn Header="Cantidad"
                                                         Binding="{Binding cantidad}"
                                                         Width="*"/>
                                    <DataGridTextColumn Header="Precio costo"
                                                         Binding="{Binding precioCosto, StringFormat='L {0:N2}'}"
                                                         Width="1.3*"/>
                                    <DataGridTextColumn Header="Subtotal"
                                                         Binding="{Binding subtotal, StringFormat='L {0:N2}'}"
                                                         Width="1.3*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                </Grid>

                <!-- Fila 14: Subtotal / Impuesto / Total -->
                <UniformGrid Grid.Row="14" Rows="1" Columns="3">
                    <Border Background="#f5f0eb" CornerRadius="8"
                            Padding="14,10" Margin="0,0,8,0">
                        <DockPanel>
                            <TextBlock Text="Subtotal" FontFamily="Poppins" FontSize="11"
                                       Foreground="#8a5c35"/>
                            <TextBlock x:Name="TxtSubtotal" Text="L 0.00"
                                       FontFamily="Poppins" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#3d2b1f" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>
                    <Border Background="#f5f0eb" CornerRadius="8"
                            Padding="14,10" Margin="4,0">
                        <DockPanel>
                            <TextBlock Text="Impuesto" FontFamily="Poppins" FontSize="11"
                                       Foreground="#8a5c35"/>
                            <TextBlock x:Name="TxtImpuesto" Text="L 0.00"
                                       FontFamily="Poppins" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#3d2b1f" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>
                    <Border Background="#fde8c8" CornerRadius="8"
                            Padding="14,10" Margin="8,0,0,0">
                        <DockPanel>
                            <TextBlock Text="Total" FontFamily="Poppins" FontSize="11"
                                       Foreground="#8a5c35"/>
                            <TextBlock x:Name="TxtTotal" Text="L 0.00"
                                       FontFamily="Poppins" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#3d2b1f" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>
                </UniformGrid>

                <!-- Fila 16: Botones finales -->
                <StackPanel Grid.Row="16"
                            Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnLimpiar"
                            Style="{StaticResource BtnSecondary}"
                            Padding="20,0" Margin="0,0,10,0"
                            Click="BtnLimpiar_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧹" FontSize="12" Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Limpiar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnGuardar"
                            Style="{StaticResource BtnPrimary}"
                            Padding="24,0"
                            Click="BtnGuardar_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Registrar y Enviar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
