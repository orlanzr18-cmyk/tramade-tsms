<UserControl x:Class="TRAMADE.FormulariosCliente.wndAprobacion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="White"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FormulariosCliente/ClientesStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="BotonNavegacion" TargetType="Button">
                <Setter Property="FontFamily" Value="Poppins"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fondo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fondo" Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Fondo" Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border CornerRadius="14" Background="#8A5C35">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="74"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="APROBACIÓN DE CLIENTES"
                       FontFamily="Poppins"
                       FontWeight="SemiBold"
                       FontSize="18"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,18,0,0"
                       Opacity="0.9"/>

            <Border Grid.Row="1" Background="White" CornerRadius="14" Margin="28,0,28,18">

                <Grid Margin="28,24,28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Búsqueda -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Búsqueda por nombre"
                                   FontFamily="Poppins" FontWeight="Bold" FontSize="13"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="txtBuscar"
                                 Grid.Column="2"
                                 TextChanged="txtBuscar_TextChanged"/>
                    </Grid>

                    <Border Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Margin="0,0,0,16"/>

                    <!-- Botones -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="btnAutorizar"
                                Style="{StaticResource BotonNavegacion}"
                                Content="AUTORIZAR SELECCIONES"
                                Width="255" Height="46"
                                Background="#27AE60"
                                Foreground="White"
                                FontFamily="Poppins"
                                FontWeight="Bold"
                                FontSize="11"
                                Margin="0,0,12,0"
                                Click="btnAutorizar_Click"/>

                        <Button x:Name="btnNegar"
                                Style="{StaticResource BotonNavegacion}"
                                Content="DENEGAR  SELECCIONES"
                                Width="255" Height="46"
                                Background="#C0392B"
                                Foreground="White"
                                FontFamily="Poppins"
                                FontWeight="Bold"
                                FontSize="11"
                                Click="btnNegar_Click"/>
                    </StackPanel>

                    <!-- Grid -->
                    <Border Grid.Row="3"
                            BorderThickness="0">
                        <DataGrid x:Name="dgvAprobacion"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="False"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Seleccionar para editar"
                                                         Binding="{Binding Seleccionado, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="140"
                                                         IsReadOnly="False"/>
                                <DataGridTextColumn Header="ID Cliente"        Binding="{Binding IdCliente}"      Width="0.8*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Nombre Cliente"    Binding="{Binding NombreCliente}"  Width="2*"   IsReadOnly="True"/>
                                <DataGridTextColumn Header="Fecha de Registro" Binding="{Binding FechaRegistro}"  Width="1.3*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Estado"           Binding="{Binding Estado}"         Width="1*"   IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>