<UserControl x:Class="TRAMADE.FormulariosCliente.ucMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:oxy="http://oxyplot.org/wpf"
             mc:Ignorable="d"
             Background="#f5f0eb"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style x:Key="BotonNavegacion" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Botones de navegación -->
        <Border Grid.Row="0"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,15"
                Margin="0,0,0,15">
            <UniformGrid Rows="1" Columns="4">
                <Button x:Name="btnRegistrar"
                        Style="{StaticResource BotonNavegacion}"
                        Content="+ REGISTRAR CLIENTE"
                        Height="52"
                        Background="#C74C3A"
                        Foreground="White"
                        FontFamily="Poppins"
                        FontWeight="Bold"
                        FontSize="11"
                        Margin="0,0,8,0"
                        Click="btnRegistrar_Click"/>

                <Button x:Name="btnActualizar"
                        Style="{StaticResource BotonNavegacion}"
                        Content="⟳ ACTUALIZAR CLIENTE"
                        Height="52"
                        Background="#8C5C68"
                        Foreground="White"
                        FontFamily="Poppins"
                        FontWeight="Bold"
                        FontSize="11"
                        Margin="0,0,8,0"
                        Click="btnActualizar_Click"/>

                <Button x:Name="btnAutorizar"
                        Style="{StaticResource BotonNavegacion}"
                        Content="☑ AUTORIZAR CLIENTE"
                        Height="52"
                        Background="#5B9A6F"
                        Foreground="White"
                        FontFamily="Poppins"
                        FontWeight="Bold"
                        FontSize="11"
                        Margin="0,0,8,0"
                        Click="btnAutorizar_Click"/>

                <Button x:Name="btnSeguimiento"
                        Style="{StaticResource BotonNavegacion}"
                        Content="📄 SEGUIMIENTO DE CLIENTE"
                        Height="52"
                        Background="#94724A"
                        Foreground="White"
                        FontFamily="Poppins"
                        FontWeight="Bold"
                        FontSize="11"
                        Click="btnSeguimiento_Click"/>
            </UniformGrid>
        </Border>

        <!-- Gráficos -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#EEEEEE"
                    BorderThickness="1"
                    CornerRadius="14"
                    Margin="0,0,8,0"
                    Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Estado de Clientes"
                               FontFamily="Poppins"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#3d2b1f"
                               Margin="0,0,0,8"/>
                    <oxy:PlotView x:Name="plotEstadoClientes" Height="200" FontFamily="Poppins"/>
                    <StackPanel x:Name="spLeyendaEstados"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#EEEEEE"
                    BorderThickness="1"
                    CornerRadius="14"
                    Margin="8,0,0,0"
                    Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Top 5 Departamentos con más Clientes"
                               FontFamily="Poppins"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#3d2b1f"
                               Margin="0,0,0,8"/>
                    <oxy:PlotView x:Name="plotTopDepartamentos" Height="240" FontFamily="Poppins"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Tarjeta única: Últimos Registros (título + grid juntos) -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#EEEEEE"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Últimos Registros"
                           FontFamily="Poppins"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#3d2b1f"
                           Margin="0,0,0,12"/>

                <DataGrid Grid.Row="1"
                          x:Name="dgUltimos"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#f0e8de"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#FAF6F0"
                          BorderThickness="0"
                          RowHeaderWidth="0"
                          SelectionMode="Single">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background"       Value="#94724A"/>
                            <Setter Property="Foreground"       Value="White"/>
                            <Setter Property="FontFamily"       Value="Poppins"/>
                            <Setter Property="FontWeight"       Value="Bold"/>
                            <Setter Property="FontSize"         Value="11"/>
                            <Setter Property="Padding"          Value="12,8"/>
                            <Setter Property="BorderThickness"  Value="0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding"         Value="12,6"/>
                            <Setter Property="FontFamily"      Value="Poppins"/>
                            <Setter Property="FontSize"        Value="11"/>
                            <Setter Property="Foreground"      Value="#3d2b1f"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID Cliente"      Binding="{Binding IdCliente}"      Width="*"/>
                        <DataGridTextColumn Header="Nombre Cliente"  Binding="{Binding NombreCliente}"  Width="2*"/>
                        <DataGridTextColumn Header="Fecha Registro"  Binding="{Binding FechaRegistro}"  Width="*"/>
                        <DataGridTextColumn Header="Estado"          Binding="{Binding Estado}"         Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

    </Grid>
</UserControl>