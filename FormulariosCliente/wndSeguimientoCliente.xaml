<UserControl x:Class="TRAMADE.FormulariosCliente.wndSeguimientoCliente"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="White"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FormulariosCliente/ClientesStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TarjetaEstadistica" TargetType="Border" BasedOn="{StaticResource CardStyle}">
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="20,16"/>
                <Setter Property="Margin" Value="0,0,16,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border CornerRadius="14" Background="#8A5C35">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="74"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="SEGUIMIENTO DE CLIENTES"
                       FontFamily="Poppins"
                       FontWeight="SemiBold"
                       FontSize="18"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,18,0,0"
                       Opacity="0.9"/>

            <Border Grid.Row="1" Background="White" CornerRadius="14" Margin="28,0,28,18">

                <Grid Margin="28,24,28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tarjetas de estadísticas -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource TarjetaEstadistica}"
                                Background="#7FB3D5">
                            <StackPanel>
                                <TextBlock Text="🗄" FontSize="20" Margin="0,0,0,4"/>
                                <TextBlock Text="Clientes Registrados"
                                           FontFamily="Poppins" FontWeight="Bold" FontSize="16"
                                           Foreground="#1A2B3D" TextWrapping="Wrap"/>
                                <TextBlock x:Name="txtRegistrados" Text="—"
                                           FontFamily="Poppins" FontWeight="Bold" FontSize="20"
                                           Foreground="#1A2B3D" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource TarjetaEstadistica}"
                                Background="#7FC97F">
                            <StackPanel>
                                <TextBlock Text="✓" FontSize="20" Margin="0,0,0,4"/>
                                <TextBlock Text="Clientes Activos"
                                           FontFamily="Poppins" FontWeight="Bold" FontSize="16"
                                           Foreground="#1A3D1A" TextWrapping="Wrap"/>
                                <TextBlock x:Name="txtActivos" Text="—"
                                           FontFamily="Poppins" FontWeight="Bold" FontSize="20"
                                           Foreground="#1A3D1A" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource TarjetaEstadistica}"
                                Background="#C0392B"
                                Margin="0">
                            <StackPanel>
                                <TextBlock Text="✕" FontSize="20" Margin="0,0,0,4" Foreground="White"/>
                                <TextBlock Text="Clientes Inactivos"
                                           FontFamily="Poppins" FontWeight="Bold" FontSize="16"
                                           Foreground="White" TextWrapping="Wrap"/>
                                <TextBlock x:Name="txtInactivos" Text="—"
                                           FontFamily="Poppins" FontWeight="Bold" FontSize="20"
                                           Foreground="White" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Búsqueda -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Búsqueda por nombre"
                                   FontFamily="Poppins" FontWeight="Bold" FontSize="13"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="txtBuscar"
                                 Grid.Column="2"
                                 TextChanged="txtBuscar_TextChanged"/>
                    </Grid>

                    <!-- Grid -->
                    <Border Grid.Row="3"
                            BorderThickness="0">
                        <DataGrid x:Name="dvgSeguimiento"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="False"
                                  SelectionMode="Single"/>
                    </Border>

                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>