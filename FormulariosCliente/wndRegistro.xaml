<UserControl x:Class="TRAMADE.FormulariosCliente.wndRegistro"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="White">

    <UserControl.Resources>
        <ResourceDictionary Source="/FormulariosCliente/ClientesStyles.xaml"/>
    </UserControl.Resources>

    <Border CornerRadius="14" Background="#8A5C35">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="74"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="REGISTRO DE CLIENTE"
                       FontFamily="Poppins"
                       FontWeight="SemiBold"
                       FontSize="18"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,18,0,0"
                       Opacity="0.9"/>

            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="14"
                    Margin="28,0,28,18">

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,10">
                    <StackPanel Margin="28,24,28,24">

                        <!-- Banner de aviso -->
                        <Border Background="#48BBD9"
                                CornerRadius="8"
                                Padding="14,10"
                                Margin="0,0,0,16">
                            <TextBlock Text="Estimado usuario los campos con (*) son necesarios."
                                       FontFamily="Poppins"
                                       FontWeight="Bold"
                                       FontSize="11"
                                       Foreground="White"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="Datos principales del cliente" Style="{StaticResource SectionLabel}"/>
                        <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Margin="0,0,0,16"/>

                        <!-- Fila: ID Cliente / Fecha de registro -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ID de cliente" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtID"
                                         Text="AUTOGENERADO"
                                         IsReadOnly="True"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Fecha de registro" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtFecha" IsReadOnly="True"/>
                            </StackPanel>
                        </Grid>

                        <!-- Fila: Nombre / Tipo de cliente -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nombre de cliente*" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtNombre"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tipo de cliente*" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbTipoCliente"
                                          SelectedValuePath="id_clasificacion_cliente"
                                          SelectionChanged="cmbTipoCliente_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding [descripcion_clasificacion_cliente]}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Fila: Razón Social / RTN -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Razón social" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbRazonSocial"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="RTN" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtRTN" MaxLength="14"/>
                            </StackPanel>
                        </Grid>

                        <!-- Fila: (vacío) / DNI -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DNI" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtDNI"
                                         MaxLength="13"
                                         PreviewTextInput="txtSoloNumeros_PreviewTextInput"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Datos de Contacto" Style="{StaticResource SectionLabel}" Margin="0,4,0,8"/>
                        <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Margin="0,0,0,16"/>

                        <!-- Fila: Contacto / Correo -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Contacto*" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtContacto"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Correo electrónico*" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtCorreo"
                                         PreviewTextInput="txtCorreo_PreviewTextInput"/>
                            </StackPanel>
                        </Grid>

                        <!-- Fila: Teléfono / Dirección -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Teléfono personal*" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtTelefono"
                                         MaxLength="8"
                                         PreviewTextInput="txtSoloNumeros_PreviewTextInput"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Dirección*" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtDireccion"/>
                            </StackPanel>
                        </Grid>

                        <!-- Fila: Departamento / Ciudad -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Departamento*" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbDepartamento"
                                          SelectedValuePath="id_departamento"
                                          SelectionChanged="cmbDepartamento_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding [nombre_departamento]}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        ToolTip="Seleccione primero un Departamento">
                                  <TextBlock Text="Ciudad*" Style="{StaticResource FieldLabel}"/>
                                  <ComboBox x:Name="cmbCiudad"
                                          SelectedValuePath="id_ciudad"
                                          IsEnabled="False">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding [nombre_ciudad]}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Botones -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,10,0,0">
                            <Button x:Name="btnLimpiar"
                                    Content="🧹 LIMPIAR"
                                    Style="{StaticResource SecondaryButton}"
                                    Width="140" Height="40"
                                    Margin="0,0,10,0"
                                    Click="btnLimpiar_Click"/>

                            <Button x:Name="btnRegistrar"
                                    Content="✓ REGISTRAR Y ENVIAR"
                                    Width="220" Height="40"
                                    Click="btnRegistrar_Click"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</UserControl>